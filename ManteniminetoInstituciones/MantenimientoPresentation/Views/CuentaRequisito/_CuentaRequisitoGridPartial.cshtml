@using Mantenimiento.Core.Application.DTOs.CuentaRequisito
@model List<CuentaRequisitoDto>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary border-bottom small text-uppercase fw-bold">
                    <tr>
                        <th class="py-3 px-3">Código Cuenta</th>
                        <th class="py-3 px-3">Descripción Cuenta</th>
                        <th class="py-3 px-3">Requisito</th>
                        <th class="py-3 px-3 text-center">Estado</th>
                        <th class="py-3 px-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-3 fw-bold">@item.CodigoCuenta</td>
                            <td class="px-3">@item.DescripcionCuenta</td>
                            <td class="px-3">@item.DescripcionRequisito</td>
                            <td class="px-3 text-center">
                                @if (item.Estado)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">Inactivo</span>
                                }
                            </td>
                            <td class="px-3 text-center">
                                <div class="d-inline-flex gap-2">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                            onclick="abrirModalEditar(@item.CuentaRequisitosID, @item.IdCuenta, @item.IdRequisito, @item.Estado.ToString().ToLower())">
                                        <i class="bi bi-pencil-square me-1"></i> Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                            onclick="eliminarRelacion(@item.CuentaRequisitosID)">
                                        <i class="bi bi-trash me-1"></i> Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary border-0 shadow-sm text-center py-5 rounded-3 mb-0" style="background-color: #f8fafc;">
        <i class="bi bi-search fs-2 text-secondary d-block mb-2"></i>
        <span class="fw-semibold text-secondary">No se encontraron requisitos asociados a los filtros seleccionados.</span>
    </div>
}