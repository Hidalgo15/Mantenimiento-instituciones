@model IEnumerable<Mantenimiento.Core.Application.DTOs.Cuenta.CuentaDto>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4" style="width: 10%;">ID</th>
                        <th style="width: 20%;">Código Cuenta</th>
                        <th style="width: 40%;">Descripción</th>
                        <th style="width: 20%;">Tipo de Trámite</th>
                        <th class="text-end pe-4" style="width: 10%;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                No se encontraron cuentas asociadas a los criterios seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">@item.IdCuenta</td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace fs-6 px-2 py-1">
                                        @item.CodigoCuenta
                                    </span>
                                </td>
                                <td class="fw-medium text-dark">@item.DescripcionCuenta</td>
                                <td>
                                    <span class="badge bg-info text-dark bg-opacity-20 border border-info px-3 py-2 rounded-pill fw-semibold">
                                        @item.TipoTramiteNombre
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-2 me-1" 
                                            onclick="abrirModalEditar(@item.IdCuenta)" title="Editar">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-2" 
                                            onclick="eliminarCuenta(@item.IdCuenta)" title="Eliminar">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>