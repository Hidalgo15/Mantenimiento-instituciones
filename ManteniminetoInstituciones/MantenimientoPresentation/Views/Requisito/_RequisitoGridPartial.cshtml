@using Mantenimiento.Core.Application.DTOs.Requisito
@model List<RequisitoDto>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary border-bottom small text-uppercase fw-bold">
                    <tr>
                        <th class="py-3 px-3" style="width: 100px;">ID</th>
                        <th class="py-3 px-3">Descripción del Requisito</th>
                        <th class="py-3 px-3 text-center" style="width: 200px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-3 fw-bold text-secondary">#@item.RequisitosID</td>
                            <td class="px-3 fw-semibold text-dark">@item.Requisitos</td>
                            <td class="px-3 text-center">
                                <div class="d-inline-flex gap-2">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                            onclick="abrirModalEditar(@item.RequisitosID, '@Html.Raw(item.Requisitos.Replace("'", "\\'"))')">
                                        <i class="bi bi-pencil-square me-1"></i> Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                            onclick="eliminarRequisito(@item.RequisitosID)">
                                        <i class="bi bi-trash me-1"></i> Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary border-0 shadow-sm text-center py-5 rounded-3 mb-0" style="background-color: #f8fafc;">
        <i class="bi bi-search fs-2 text-secondary d-block mb-2"></i>
        <span class="fw-semibold text-secondary">No se encontraron requisitos registrados.</span>
    </div>
}