@{
    ViewData["Title"] = "Gestión de Requisitos";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-0 text-dark">Gestión de Requisitos</h4>
            <small class="text-muted">Administre los requisitos institucionales para las cuentas contables</small>
        </div>
        <button type="button" class="btn btn-cgr-primary rounded-pill px-4" onclick="abrirModalCrear()">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Requisito
        </button>
    </div>

    <!-- Filtro de Búsqueda -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <div class="row align-items-end g-3">
                <div class="col-md-6">
                    <label for="txtBusqueda" class="form-label fw-bold text-dark mb-2">
                        <i class="bi bi-search me-1" style="color: #0d5493;"></i> Buscar Requisito
                    </label>
                    <div class="input-group">
                        <!-- filtrar al escribir -->
                        <input type="text" id="txtBusqueda" class="form-control rounded-start-pill border-secondary-subtle"
                               placeholder="Escriba para filtrar por descripción..." oninput="cargarGrid()" />
                        <button type="button" class="btn btn-outline-secondary rounded-end-pill px-3"
                                onclick="limpiarBusqueda()" title="Limpiar búsqueda">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>

<!-- Contenedor Grid -->
<div id="contenedorGrid">
    <div class="text-center py-5 bg-white rounded-3 border shadow-sm">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p class="text-muted mb-0 fw-semibold">Cargando requisitos...</p>
    </div>
</div>
</div>

<!-- Modal Crear / Editar -->
<div class="modal fade" id="modalMantenimiento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white px-4 py-3" style="background-color: #0d5493;">
                <h5 class="modal-title fw-bold" id="modalTitle">Nuevo Requisito</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formMantenimiento">
                    <input type="hidden" id="hdnRequisitosID" value="0" />

                    <div class="mb-3">
                        <label for="txtDescripcion" class="form-label fw-bold text-dark">Descripción del Requisito</label>
                        <textarea id="txtDescripcion" class="form-control rounded-3" rows="3" required placeholder="Ej: Copia de cédula del representante..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-top-0 px-4 py-3">
                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-cgr-primary px-4 rounded-pill" onclick="guardarRequisito()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalBs;
        document.addEventListener('DOMContentLoaded', () => {
            modalBs = new bootstrap.Modal(document.getElementById('modalMantenimiento'));
            cargarGrid();
        });

        function cargarGrid() {
            const busqueda = document.getElementById('txtBusqueda').value.trim();
            const params = new URLSearchParams({ busqueda });

            fetch(`/Requisito/ObtenerGrid?${params.toString()}`)
                .then(res => res.text())
                .then(html => document.getElementById('contenedorGrid').innerHTML = html);
        }

        function limpiarBusqueda() {
            document.getElementById('txtBusqueda').value = '';
            cargarGrid();
        }

        function abrirModalCrear() {
            document.getElementById('hdnRequisitosID').value = '0';
            document.getElementById('txtDescripcion').value = '';
            document.getElementById('modalTitle').innerText = 'Nuevo Requisito';
            modalBs.show();
        }

        function abrirModalEditar(id, descripcion) {
            document.getElementById('hdnRequisitosID').value = id;
            document.getElementById('txtDescripcion').value = descripcion;
            document.getElementById('modalTitle').innerText = 'Editar Requisito';
            modalBs.show();
        }

        function guardarRequisito() {
            const id = parseInt(document.getElementById('hdnRequisitosID').value);
            const descripcion = document.getElementById('txtDescripcion').value.trim();

            if (!descripcion) {
                alert('La descripción del requisito es obligatoria.');
                return;
            }

            const url = id === 0 ? '/Requisito/Guardar' : '/Requisito/Actualizar';
            const dto = id === 0 ? { requisitoDescripcion: descripcion } : { requisitosID: id, requisitoDescripcion: descripcion };

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        modalBs.hide();
                        cargarGrid();
                    } else {
                        alert(data.message);
                    }
                });
        }

        function eliminarRequisito(id) {
            if (!confirm('¿Está seguro de eliminar este requisito?')) return;

            fetch('/Requisito/Eliminar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(id)
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        cargarGrid();
                    } else {
                        alert(data.message);
                    }
                });
        }
    </script>
}