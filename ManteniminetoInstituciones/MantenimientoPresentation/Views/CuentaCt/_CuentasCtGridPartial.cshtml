@using Mantenimiento.Core.Application.DTOs.Cuenta.CtCuentasDTO
@model IEnumerable<CuentaCtDto>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom text-uppercase fs-7 text-secondary fw-bold">
                    <tr>
                        <th class="ps-4" style="width: 15%;">ID Cuenta</th>
                        <th style="width: 25%;">Código de Cuenta</th>
                        <th style="width: 45%;">Descripción</th>
                        <th class="text-end pe-4" style="width: 15%;">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                No se encontraron cuentas registradas en el catálogo base.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">@item.IdCuenta</td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace fs-6 px-3 py-1 rounded-pill">
                                        @item.CodigoCuenta
                                    </span>
                                </td>
                                <td class="fw-medium text-dark">@item.DescripcionCuenta</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" 
                                                onclick="abrirModalEditar(@item.CuentaID)" title="Editar">
                                            <i class="bi bi-pencil-square me-1"></i> Editar
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                onclick="eliminarCuentaCt(@item.CuentaID)" title="Eliminar">
                                            <i class="bi bi-trash me-1"></i> Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>