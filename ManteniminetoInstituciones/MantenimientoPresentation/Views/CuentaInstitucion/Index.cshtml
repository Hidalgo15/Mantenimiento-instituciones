@using Mantenimiento.Core.Application.DTOs
@{
    ViewData["Title"] = "Gestión de Cuentas por Institución";
    var instituciones = ViewBag.Instituciones as List<InstitucionSeleccionDto> ?? new List<InstitucionSeleccionDto>();
}

<div class="container py-4">
    <h3 class="fw-bold mb-4">Gestión de Cuentas por Institución</h3>

    <!-- SELECTOR DE INSTITUCIÓN -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-8">
                    <label for="selectInstitucion" class="form-label fw-bold">Seleccionar Institución</label>
                    <select id="selectInstitucion" class="form-select" onchange="cargarGridCuentas()">
                        <option value="">-- Seleccione una institución --</option>
                        @foreach (var inst in instituciones)
                        {
                            <option value="@inst.Estructura">@inst.UnidadEjecutora (@inst.Estructura)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 text-end">
                    <button type="button" class="btn btn-primary" onclick="abrirModalCrear()" id="btnNuevaCuenta" disabled>
                        <i class="bi bi-plus-lg me-1"></i> Nueva Cuenta
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENEDOR DEL GRID -->
    <div id="contenedorGrid">
        <div class="alert alert-info text-center">
            Selecciona una institución para cargar sus cuentas asociadas.
        </div>
    </div>
</div>

<!-- MODAL CREAR CUENTA -->
<div class="modal fade" id="modalCrearCuenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Agregar Cuenta Institucional</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formCrearCuenta">
                    <input type="hidden" id="txtInsCodigo" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Institución</label>
                        <input type="text" id="txtInstitucion" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cuenta Banco</label>
                        <input type="text" id="txtCtaCtaBanco" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Descripción de Cuenta</label>
                        <input type="text" id="txtCtaDescripcion" class="form-control" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" onclick="guardarCuenta()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cargarGridCuentas() {
            const insCodigo = document.getElementById('selectInstitucion').value;
            const btnNueva = document.getElementById('btnNuevaCuenta');
            const contenedor = document.getElementById('contenedorGrid');

            if (!insCodigo) {
                btnNueva.disabled = true;
                contenedor.innerHTML = '<div class="alert alert-info text-center">Selecciona una institución para cargar sus cuentas asociadas.</div>';
                return;
            }

            btnNueva.disabled = false;
            contenedor.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';

            fetch(`/CuentaInstitucion/ObtenerCuentasGrid?insCodigo=${encodeURIComponent(insCodigo)}`)
                .then(res => res.text())
                .then(html => {
                    contenedor.innerHTML = html;
                });
        }

        function abrirModalCrear() {
            const select = document.getElementById('selectInstitucion');
            const insCodigo = select.value;
            const institucionNombre = select.options[select.selectedIndex].text;

            document.getElementById('txtInsCodigo').value = insCodigo;
            document.getElementById('txtInstitucion').value = institucionNombre;
            document.getElementById('txtCtaCtaBanco').value = '';
            document.getElementById('txtCtaDescripcion').value = '';

            var modal = new bootstrap.Modal(document.getElementById('modalCrearCuenta'));
            modal.show();
        }

        function guardarCuenta() {
            const dto = {
                insCodigo: document.getElementById('txtInsCodigo').value,
                institucion: document.getElementById('txtInstitucion').value,
                ctaCtaBanco: document.getElementById('txtCtaCtaBanco').value,
                ctaDescripcion: document.getElementById('txtCtaDescripcion').value
            };

            fetch('/CuentaInstitucion/Crear', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('modalCrearCuenta')).hide();
                    cargarGridCuentas();
                } else {
                    alert('Error: ' + data.message);
                }
            });
        }

        function eliminarCuenta(id) {
            if (!confirm('¿Desea eliminar este registro?')) return;

            fetch(`/CuentaInstitucion/Eliminar?id=${id}`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        cargarGridCuentas();
                    } else {
                        alert('Error al eliminar: ' + data.message);
                    }
                });
        }
    </script>
}