@using Mantenimiento.Core.Application.DTOs
@model List<CuentaInstitucionDto>

@if (Model != null && Model.Any())
{
    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Estructura / Cód</th>
                    <th>Institución</th>
                    <th>Cuenta Banco</th>
                    <th>Descripción</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.InsCodigo</td>
                        <td>@item.Institucion</td>
                        <td>@item.CtaCtaBanco</td>
                        <td>@item.CtaDescripcion</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary me-1" onclick="abrirModalEditar(@item.Id)">
                                <i class="bi bi-pencil"></i> Editar
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="eliminarCuenta(@item.Id)">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning text-center mb-0">
        No se encontraron cuentas registradas para esta institución.
    </div>
}