@using Mantenimiento.Core.Application.DTOs.CuentaInstitucion
@model List<CuentaInstitucionDto>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary border-bottom small text-uppercase fw-bold">
                    <tr>
                        <th class="py-3 px-3">ID</th>
                        <th class="py-3 px-3">Estructura / Cód</th>
                        <th class="py-3 px-3">Institución</th>
                        <th class="py-3 px-3">Cuenta Banco</th>
                        <th class="py-3 px-3">Descripción</th>
                        <th class="py-3 px-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-3 fw-bold text-secondary">@item.Id</td>
                            <td class="px-3">
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-1">@item.InsCodigo</span>
                            </td>
                            <td class="px-3 small text-uppercase text-secondary fw-semibold">@item.Institucion</td>
                            <td class="px-3 fw-bold text-dark">@item.CtaCtaBanco</td>
                            <td class="px-3 text-dark">@item.CtaDescripcion</td>
                            <td class="px-3 text-center">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1" onclick="abrirModalEditar(@item.Id)">
                                    <i class="bi bi-pencil-square me-1"></i> Editar
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="eliminarCuenta(@item.Id)">
                                    <i class="bi bi-trash me-1"></i> Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary border-0 shadow-sm text-center py-5 rounded-3 mb-0" style="background-color: #f8fafc;">
        <i class="bi bi-bank fs-2 text-secondary d-block mb-2"></i>
        <span class="fw-semibold text-secondary">No se encontraron cuentas registradas para esta institución.</span>
    </div>
}