@using Mantenimiento.Core.Application.DTOs.ResponsableActividad
@{
    ViewData["Title"] = "Asignación por Actividad";
    var moldes = ViewBag.Moldes as List<MoldeCatalogoDto> ?? new List<MoldeCatalogoDto>();
}

<div class="container-fluid py-3">
    <!-- CABECERA -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-0 text-dark">Asignación de Usuarios por Actividad</h4>
            <small class="text-muted">Seleccione en cascada un molde, sus subtipos, la actividad y gestione los usuarios con filtros avanzados</small>
        </div>
        <span class="badge text-white py-2 px-3 fs-6 rounded-pill" style="background-color: #0d5493;">
            <i class="bi bi-diagram-3-fill me-1"></i> Flujo por Actividad
        </span>
    </div>

    <!-- SELECCIÓN EN CASCADA VERTICAL -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 bg-white rounded-4">
            <div class="row g-3">
                <!-- 1. Molde -->
                <div class="col-md-12">
                    <label for="selectMolde" class="form-label fw-bold text-dark mb-2">
                        <i class="bi bi-folder-fill me-1" style="color: #0d5493;"></i> 1. Seleccione un Molde
                    </label>
                    <select id="selectMolde" class="form-select rounded-pill border-secondary-subtle py-2" onchange="cargarSubtiposMolde()">
                        <option value="">-- Seleccione un Molde --</option>
                        @foreach (var molde in moldes)
                        {
                            <option value="@molde.CodigoTre">@molde.NombreTre (@molde.ArbolAsociado)</option>
                        }
                    </select>
                </div>

                <!-- 2. Subtipos Asociados (Cascada Abajo) -->
                <div class="col-md-12 mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold text-dark mb-0">
                            <i class="bi bi-diagram-2-fill me-1" style="color: #0d5493;"></i> 2. Subtipos Asociados
                        </label>
                        <button type="button" id="btnSelectAllSubtipos" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fs-7 d-none" onclick="toggleSelectAllSubtipos()">
                            <i class="bi bi-check-all me-1"></i> Seleccionar todos
                        </button>
                    </div>
                    <div id="contenedorSubtipos" class="border border-secondary-subtle rounded-3 p-3 bg-light-subtle" style="max-height: 180px; overflow-y: auto;">
                        <span class="text-muted small fst-italic">Seleccione un molde primero...</span>
                    </div>
                </div>

                <!-- 3. Actividad con Subtipos Segmentados (Agrupados por Categoría / Título Destacado) -->
                <div class="col-md-12 mt-3">
                    <label for="selectActividad" class="form-label fw-bold text-dark mb-2">
                        <i class="bi bi-check2-square me-1" style="color: #0d5493;"></i> 3. Seleccione la Actividad a Asignar
                    </label>
                    <select id="selectActividad" class="form-select rounded-pill border-secondary-subtle py-2 shadow-sm" onchange="cargarUsuariosPorActividad()" disabled>
                        <option value="">-- Seleccione subtipos primero --</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENEDOR DE USUARIOS Y FILTROS -->
    <div id="contenedorGestionUsuarios" class="d-none">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">
                            <i class="bi bi-people-fill me-2" style="color: #0d5493;"></i> Gestión de Usuarios por Asignar
                        </h5>
                        <p class="text-muted small mb-0">Marque los usuarios deseados y guarde los cambios realizados.</p>
                    </div>
                    <button type="button" id="btnGuardarCambios" class="btn btn-cgr-primary rounded-pill px-4 py-2 opacity-50" onclick="guardarAsignacionUsuarios()" disabled>
                        <i class="bi bi-save me-1"></i> Guardar Cambios
                    </button>
                </div>

                <!-- BARRA DE FILTROS Y BÚSQUEDA RÁPIDA -->
                <div class="row g-3 align-items-center mb-3 bg-light p-3 rounded-3">
                    <!-- Filtros por Estado (Todos / Asignados / No Asignados) -->
                    <div class="col-md-6">
                        <div class="btn-group w-100" role="group" aria-label="Filtro de asignación">
                            <button type="button" class="btn btn-outline-secondary btn-sm active" id="btnFiltroTodas" onclick="filtrarEstadoUsuarios('todas')">
                                <i class="bi bi-collection me-1"></i> Todos
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm" id="btnFiltroAsignadas" onclick="filtrarEstadoUsuarios('asignadas')">
                                <i class="bi bi-check-circle me-1"></i> Asignados
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" id="btnFiltroNoAsignadas" onclick="filtrarEstadoUsuarios('no-asignadas')">
                                <i class="bi bi-x-circle me-1"></i> No Asignados
                            </button>
                        </div>
                    </div>

                    <!-- Buscador general optimizado -->
                    <div class="col-md-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-secondary-subtle text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="filtroBusquedaGeneral" class="form-control border-secondary-subtle"
                                   placeholder="Filtrar por nombre, cargo o área..." oninput="manejarBusquedaOptimizada()" />
                            <button type="button" class="btn btn-outline-secondary" onclick="limpiarBusquedaUsuarios()">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div id="gridUsuariosContenedor">
                    <!-- Grid inyectado por AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let filtroEstadoActual = 'todas';
        let estadoInicialCheckboxes = new Set();
        let temporizadorBusqueda = null;

        document.addEventListener('change', function(e) {
            if (e.target && e.target.classList.contains('chk-usuario-asignacion')) {
                evaluarCambiosPendientes();
            }
        });

        function cargarSubtiposMolde() {
            const codigoTre = document.getElementById('selectMolde').value;
            const contenedorSubtipos = document.getElementById('contenedorSubtipos');
            const selectActividad = document.getElementById('selectActividad');
            const btnSelectAll = document.getElementById('btnSelectAllSubtipos');

            contenedorSubtipos.innerHTML = '<span class="text-muted small fst-italic">Cargando subtipos...</span>';
            btnSelectAll.classList.add('d-none');
            selectActividad.innerHTML = '<option value="">-- Seleccione subtipos primero --</option>';
            selectActividad.disabled = true;
            document.getElementById('contenedorGestionUsuarios').classList.add('d-none');

            if (!codigoTre) {
                contenedorSubtipos.innerHTML = '<span class="text-muted small fst-italic">Seleccione un molde primero...</span>';
                return;
            }

            fetch(`/ResponsableActividad/ObtenerSubtipos?codigoTre=${codigoTre}`)
                .then(res => res.json())
                .then(res => {
                    if (res.success && res.data.length > 0) {
                        let html = '';
                        res.data.forEach(sub => {
                            html += `
                                <div class="form-check py-1 my-1">
                                    <input class="form-check-input chk-subtipo fs-5 border-secondary" type="checkbox" value="${sub.codigoTipoTre}" id="sub_${sub.codigoTipoTre}" onchange="procesarCambioSubtipos()">
                                    <label class="form-check-label fs-6 fw-semibold text-dark ms-1" style="cursor: pointer;" for="sub_${sub.codigoTipoTre}">
                                        ${sub.descripcion} <span class="text-muted fw-normal">(${sub.abreviatura || 'N/A'})</span>
                                    </label>
                                </div>`;
                        });
                        contenedorSubtipos.innerHTML = html;
                        btnSelectAll.classList.remove('d-none');
                        btnSelectAll.textContent = 'Seleccionar todos';
                    } else {
                        contenedorSubtipos.innerHTML = '<span class="text-danger small">No se encontraron subtipos para este molde.</span>';
                    }
                });
        }

        function toggleSelectAllSubtipos() {
            const checkboxes = document.querySelectorAll('.chk-subtipo');
            const btnSelectAll = document.getElementById('btnSelectAllSubtipos');
            const todosMarcados = Array.from(checkboxes).every(chk => chk.checked);

            checkboxes.forEach(chk => { chk.checked = !todosMarcados; });
            btnSelectAll.innerHTML = todosMarcados ? '<i class="bi bi-check-all me-1"></i> Seleccionar todos' : '<i class="bi bi-dash-circle me-1"></i> Desmarcar todos';

            procesarCambioSubtipos();
        }

        function procesarCambioSubtipos() {
            const checkboxes = document.querySelectorAll('.chk-subtipo:checked');
            const selectActividad = document.getElementById('selectActividad');

            document.getElementById('contenedorGestionUsuarios').classList.add('d-none');

            if (checkboxes.length === 0) {
                selectActividad.innerHTML = '<option value="">-- Seleccione subtipos primero --</option>';
                selectActividad.disabled = true;
                return;
            }

            // Mapeamos el ID del subtipo limpiando la abreviatura final del label (ej: quita el "(CSP)")
            const subtiposInfo = {};
            checkboxes.forEach(chk => {
                const label = document.querySelector(`label[for="${chk.id}"]`);
                if (label) {
                    // Clonamos el texto del label y le quitamos la abreviatura que va entre paréntesis al final (ej. " (CSP)")
                    let textoLimpio = label.textContent.replace(/\s+/g, ' ').trim();
                    // Esto remueve el segmento final entre paréntesis si es una abreviatura (ej. " (CSP)")
                    textoLimpio = textoLimpio.replace(/\s*\([A-Z0-9_-]+\)$/, '');
                    
                    subtiposInfo[chk.value] = textoLimpio;
                }
            });

            const codigosSubtipos = Object.keys(subtiposInfo);

            selectActividad.innerHTML = '<option value="">Cargando actividades...</option>';
            selectActividad.disabled = true;

            fetch(`/ResponsableActividad/ObtenerActividadesPorSubtipos?codigosSubtipos=${encodeURIComponent(codigosSubtipos.join(','))}`)
                .then(res => res.json())
                .then(res => {
                    if (res.success && res.actividades.length > 0) {
                        let html = '<option value="">-- Seleccione una Actividad --</option>';

                        // Agrupamos usando el nombre limpio sin abreviatura
                        const actividadesPorSubtipo = {};
                        res.actividades.forEach(act => {
                            const nombreSubtipo = subtiposInfo[act.codigoTipoTre] || act.descripcionSubtipo || 'Otros';
                            if (!actividadesPorSubtipo[nombreSubtipo]) {
                                actividadesPorSubtipo[nombreSubtipo] = [];
                            }
                            actividadesPorSubtipo[nombreSubtipo].push(act);
                        });

                        // Construimos los grupos con los títulos limpios
                        for (const [subtipo, lista] of Object.entries(actividadesPorSubtipo)) {
                            html += `<optgroup label="📂 ${subtipo}">`;
                            lista.forEach(act => {
                                const textoCorto = act.descripcionActividad;
                                const textoConSubtipo = `${act.descripcionActividad} (${subtipo})`;
                                
                                html += `<option value="${act.codigoActividad}" data-display-text="${textoConSubtipo}">${textoCorto}</option>`;
                            });
                            html += `</optgroup>`;
                        }

                        selectActividad.innerHTML = html;
                        selectActividad.disabled = false;
                    } else {
                        selectActividad.innerHTML = '<option value="">No hay actividades disponibles para estos subtipos.</option>';
                        selectActividad.disabled = true;
                    }
                });
        }

        // Lógica para que al seleccionar la actividad, se muestre limpia por dentro pero con el subtipo entre paréntesis al seleccionarla
        document.addEventListener('DOMContentLoaded', () => {
            const selectActividad = document.getElementById('selectActividad');
            if (selectActividad) {
                selectActividad.addEventListener('change', function() {
                    const optionSeleccionada = this.options[this.selectedIndex];
                    const textoConSubtipo = optionSeleccionada.getAttribute('data-display-text');
                    
                    if (textoConSubtipo) {
                        optionSeleccionada.textContent = textoConSubtipo;
                    }
                    
                    Array.from(this.options).forEach(opt => {
                        if (opt !== optionSeleccionada && opt.hasAttribute('data-display-text')) {
                            const originalText = opt.getAttribute('data-display-text').split(' (')[0];
                            opt.textContent = originalText;
                        }
                    });
                });
            }
        });

        function cargarUsuariosPorActividad() {
            const codigoActividad = document.getElementById('selectActividad').value;
            const codigoTre = document.getElementById('selectMolde').value;
            const contenedorGestion = document.getElementById('contenedorGestionUsuarios');

            if (!codigoActividad) {
                contenedorGestion.classList.add('d-none');
                return;
            }

            const url = `/ResponsableActividad/ObtenerGrid?codigoActividad=${codigoActividad}&codigoTre=${codigoTre}`;

            fetch(url)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('gridUsuariosContenedor').innerHTML = html;
                    contenedorGestion.classList.remove('d-none');
                    capturarEstadoInicial();
                    evaluarCambiosPendientes();
                    aplicarFiltrosTablaUsuarios();
                });
        }

        function capturarEstadoInicial() {
            estadoInicialCheckboxes.clear();
            document.querySelectorAll('.chk-usuario-asignacion').forEach(chk => {
                if (chk.checked) estadoInicialCheckboxes.add(chk.value);
            });
        }

        function evaluarCambiosPendientes() {
            let hayCambios = false;
            document.querySelectorAll('.chk-usuario-asignacion').forEach(chk => {
                if (chk.checked !== estadoInicialCheckboxes.has(chk.value)) hayCambios = true;
            });

            const btnGuardar = document.getElementById('btnGuardarCambios');
            if(btnGuardar) {
                btnGuardar.disabled = !hayCambios;
                if (hayCambios) btnGuardar.classList.remove('opacity-50');
                else btnGuardar.classList.add('opacity-50');
            }
        }

        function guardarAsignacionUsuarios() {
            const codigoActividad = document.getElementById('selectActividad').value;
            const codigoTre = document.getElementById('selectMolde').value;
            if (!codigoActividad) return;

            const listaDespa = Array.from(document.querySelectorAll('.chk-usuario-asignacion:checked')).map(chk => chk.value);

            const dto = {
                codigoActividad: parseInt(codigoActividad),
                codigoTre: parseInt(codigoTre),
                listaCodigosDespa: listaDespa.join(',')
            };

            fetch('/ResponsableActividad/GuardarAsignacionInversa', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    capturarEstadoInicial();
                    evaluarCambiosPendientes();
                    aplicarFiltrosTablaUsuarios();
                } else {
                    alert('Error: ' + data.message);
                }
            });
        }

        async function filtrarEstadoUsuarios(nuevoEstado) {
            if (filtroEstadoActual === nuevoEstado) return;

            const checkboxes = document.querySelectorAll('.chk-usuario-asignacion');
            let cambiosPendientesCount = 0;
            checkboxes.forEach(chk => {
                if (chk.checked !== estadoInicialCheckboxes.has(chk.value)) cambiosPendientesCount++;
            });

            if (cambiosPendientesCount > 0) {
                const mensajeDetallado = `Tiene ${cambiosPendientesCount} ${cambiosPendientesCount === 1 ? 'modificación pendiente' : 'modificaciones pendientes'} sin guardar.\n\nSi cambia de filtro en este momento, se perderán los cambios realizados. ¿Desea continuar?`;

                const confirmar = await confirmarAccion(
                    mensajeDetallado,
                    {
                        kind: 'warning',
                        title: 'Cambios sin guardar (' + cambiosPendientesCount + ')',
                        confirmText: 'Sí, descartar cambios',
                        cancelText: 'Seguir editando'
                    }
                );

                if (!confirmar) {
                    return;
                } else {
                    checkboxes.forEach(chk => {
                        chk.checked = estadoInicialCheckboxes.has(chk.value);
                    });
                    evaluarCambiosPendientes();
                }
            }

            filtroEstadoActual = nuevoEstado;
            document.getElementById('btnFiltroTodas').className = `btn btn-outline-secondary btn-sm ${nuevoEstado === 'todas' ? 'active' : ''}`;
            document.getElementById('btnFiltroAsignadas').className = `btn btn-outline-success btn-sm ${nuevoEstado === 'asignadas' ? 'active' : ''}`;
            document.getElementById('btnFiltroNoAsignadas').className = `btn btn-outline-danger btn-sm ${nuevoEstado === 'no-asignadas' ? 'active' : ''}`;

            aplicarFiltrosTablaUsuarios();
        }

        function manejarBusquedaOptimizada() {
            clearTimeout(temporizadorBusqueda);
            temporizadorBusqueda = setTimeout(() => {
                aplicarFiltrosTablaUsuarios();
            }, 200);
        }

        function limpiarBusquedaUsuarios() {
            document.getElementById('filtroBusquedaGeneral').value = '';
            aplicarFiltrosTablaUsuarios();
        }

        function aplicarFiltrosTablaUsuarios() {
            const textoFiltro = document.getElementById('filtroBusquedaGeneral').value.toLowerCase().trim();
            const filas = document.querySelectorAll('#tablaUsuariosAsignacion tbody tr');
            let visiblesCount = 0;

            filas.forEach(fila => {
                const checkbox = fila.querySelector('.chk-usuario-asignacion');
                const codigoDespa = checkbox ? checkbox.value : '';
                const estaAsignadaOriginal = estadoInicialCheckboxes.has(codigoDespa);
                
                const textoFila = fila.getAttribute('data-search') || fila.innerText.toLowerCase();

                let cumpleEstado = true;
                if (filtroEstadoActual === 'asignadas' && !estaAsignadaOriginal) cumpleEstado = false;
                if (filtroEstadoActual === 'no-asignadas' && estaAsignadaOriginal) cumpleEstado = false;

                const cumpleTexto = !textoFiltro || textoFila.includes(textoFiltro);

                if (cumpleEstado && cumpleTexto) {
                    fila.style.display = '';
                    visiblesCount++;
                } else {
                    fila.style.display = 'none';
                }
            });

            let alertVacio = document.getElementById('alertaFiltroVacio');
            const tablaContainer = document.querySelector('#tablaUsuariosAsignacion')?.closest('.table-responsive');

            if (visiblesCount === 0) {
                if (!alertVacio && tablaContainer) {
                    alertVacio = document.createElement('div');
                    alertVacio.id = 'alertaFiltroVacio';
                    alertVacio.className = 'alert alert-secondary border-0 shadow-sm text-center py-3 rounded-3 mt-2 mb-0';
                    alertVacio.style.backgroundColor = '#f8fafc';
                    alertVacio.innerHTML = '<i class="bi bi-info-circle fs-5 text-secondary d-block mb-1"></i><span class="fw-semibold text-secondary small">No hay usuarios para mostrar en este filtro o búsqueda.</span>';
                    tablaContainer.parentNode.appendChild(alertVacio);
                } else if (alertVacio) {
                    alertVacio.style.display = '';
                }
            } else {
                if (alertVacio) {
                    alertVacio.style.display = 'none';
                }
            }
        }
    </script>
}