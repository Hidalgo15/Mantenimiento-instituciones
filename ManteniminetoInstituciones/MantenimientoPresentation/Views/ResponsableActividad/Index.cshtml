@using Mantenimiento.Core.Application.DTOs.ResponsableActividad
@{
    ViewData["Title"] = "Asignación por Flujo";
    var moldes = ViewBag.Moldes as List<MoldeCatalogoDto> ?? new List<MoldeCatalogoDto>();
    var errorCargaMoldes = ViewBag.ErrorCargaMoldes as string;
}

<div class="container-fluid py-3">
    @if (!string.IsNullOrWhiteSpace(errorCargaMoldes))
    {
        <div class="alert alert-danger d-flex align-items-start gap-3" role="alert">
            <i class="bi bi-exclamation-circle-fill mt-1" aria-hidden="true"></i>
            <div>
                <strong class="d-block">No se pudo preparar la pantalla</strong>
                <span>@errorCargaMoldes</span>
            </div>
        </div>
    }

    <!-- CABECERA -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-0 text-dark">Asignación Masiva por Flujo de Trabajo</h4>
            <small class="text-muted">Seleccione un molde y el flujo correspondiente para gestionar los responsables de forma integrada</small>
        </div>
        <span class="badge text-white py-2 px-3 fs-6 rounded-pill" style="background-color: #0d5493;">
            <i class="bi bi-diagram-3-fill me-1"></i> Asignación por Flujo
        </span>
    </div>

    <!-- SELECCIÓN EN CASCADA (MOLDE -> FLUJO) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 bg-white rounded-4">
            <div class="row g-3">
                <!-- 1. Molde -->
                <div class="col-md-12">
                    <label for="selectMolde" class="form-label fw-bold text-dark mb-2">
                        <i class="bi bi-folder-fill me-1" style="color: #0d5493;"></i> 1. Seleccione un Molde
                    </label>
                    <select id="selectMolde" class="form-select rounded-pill border-secondary-subtle py-2" onchange="cargarFlujosMolde()" aria-describedby="estadoFlujos" disabled="@(moldes.Count == 0)">
                        <option value="">-- Seleccione un Molde --</option>
                        @foreach (var molde in moldes)
                        {
                            <option value="@molde.CodigoTre">@molde.NombreTre (@molde.ArbolAsociado)</option>
                        }
                    </select>
                </div>

                <!-- 2. Flujo de Trabajo (Carga Directa de Usuarios al Seleccionar) -->
                <div class="col-md-12 mt-3" id="seccionFlujos">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label for="selectFlujo" class="form-label fw-bold text-dark mb-0">
                            <i class="bi bi-diagram-2-fill me-1" style="color: #0d5493;"></i> 2. Seleccione el Flujo de Trabajo
                        </label>
                        <button type="button" id="btnVerActividadesFlujo" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 d-none" onclick="previsualizarActividadesFlujo()">
                            <i class="bi bi-eye-fill me-1"></i> Ver actividades de este flujo
                        </button>
                    </div>
                    <select id="selectFlujo" class="form-select rounded-pill border-secondary-subtle py-2 shadow-sm" onchange="cargarUsuariosPorFlujo()" aria-describedby="estadoFlujos" disabled>
                        <option value="">-- Seleccione un molde primero --</option>
                    </select>
                    <div id="estadoFlujos" class="small mt-2" aria-live="polite"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENEDOR DE USUARIOS Y FILTROS -->
    <div id="contenedorGestionUsuarios" class="d-none">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">
                            <i class="bi bi-people-fill me-2" style="color: #0d5493;"></i> Gestión de Responsables del Flujo
                        </h5>
                        <p class="text-muted small mb-0">Marque los usuarios que asumirán este flujo de trabajo y guarde los cambios.</p>

                        <span id="lblFlujoSeleccionado" class="badge bg-primary-subtle text-primary border border-primary-subtle mt-2 px-3 py-1 fs-6 fw-semibold d-none">
                            <i class="bi bi-diagram-2 me-1"></i> Flujo activo: <span class="fw-bold"></span>
                        </span>
                    </div>
                    <div class="d-flex flex-column align-items-md-end gap-2">
                        <span id="estadoCambios" class="small text-warning-emphasis d-none" role="status">
                            <i class="bi bi-pencil-fill me-1" aria-hidden="true"></i> Tiene cambios sin guardar
                        </span>
                        <button type="button" id="btnGuardarCambios" class="btn btn-cgr-primary rounded-pill px-4 py-2 opacity-50" onclick="guardarAsignacionFlujo()" disabled>
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </div>

                <!-- BARRA DE FILTROS Y BÚSQUEDA RÁPIDA -->
                <div class="row g-3 align-items-center mb-3 bg-light p-3 rounded-3">
                    <div class="col-md-6">
                        <div class="btn-group w-100" role="group" aria-label="Filtro de asignación">
                            <button type="button" class="btn btn-outline-secondary btn-sm active" id="btnFiltroTodas" onclick="filtrarEstadoUsuarios('todas')" aria-pressed="true">
                                <i class="bi bi-collection me-1"></i> Todos
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm" id="btnFiltroAsignadas" onclick="filtrarEstadoUsuarios('asignadas')" aria-pressed="false">
                                <i class="bi bi-check-circle me-1"></i> Asignados
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" id="btnFiltroNoAsignadas" onclick="filtrarEstadoUsuarios('no-asignadas')" aria-pressed="false">
                                <i class="bi bi-x-circle me-1"></i> No Asignados
                            </button>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-secondary-subtle text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="filtroBusquedaGeneral" class="form-control border-secondary-subtle"
                                   placeholder="Filtrar por nombre, cargo o área..." aria-label="Buscar usuarios" oninput="manejarBusquedaOptimizada()" />
                            <button type="button" class="btn btn-outline-secondary" onclick="limpiarBusquedaUsuarios()" aria-label="Limpiar búsqueda">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div id="gridUsuariosContenedor" aria-live="polite" aria-busy="false"></div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PARA PREVISUALIZAR ACTIVIDADES DEL FLUJO -->
<div class="modal fade" id="modalPrevisualizarFlujo" tabindex="-1" aria-labelledby="modalPrevisualizarFlujoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-light border-0 rounded-top-4">
                <h5 class="modal-title fw-bold text-dark" id="modalPrevisualizarFlujoLabel">
                    <i class="bi bi-list-check me-2 text-primary"></i> Actividades que componen este Flujo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">Al guardar los cambios, estas actividades se asignarán o desasignarán de forma masiva a los usuarios seleccionados:</p>
                <div id="listaActividadesFlujoContenedor" class="list-group" style="max-height: 350px; overflow-y: auto;">
                    <!-- Se llena dinámicamente -->
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PARA GESTIONAR ACTIVIDADES DE UN USUARIO ESPECÍFICO -->
<div class="modal fade" id="modalGestionarUsuarioIndividual" tabindex="-1" aria-labelledby="modalGestionarUsuarioIndividualLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-light border-0 rounded-top-4">
                <h5 class="modal-title fw-bold text-dark" id="modalGestionarUsuarioIndividualLabel">
                    <i class="bi bi-person-gear me-2 text-primary"></i> Gestión Individual de Actividades
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <span class="text-muted small d-block">Usuario seleccionado:</span>
                    <strong id="lblNombreUsuarioModal" class="text-dark fs-6"></strong>
                    <input type="hidden" id="txtDespaModal" />
                </div>
                <p class="text-muted small mb-2">Marque o desmarque las actividades que este usuario debe tener asignadas puntualmente:</p>
                <div id="gridActividadesUsuarioContenedor" style="max-height: 350px; overflow-y: auto;" class="border rounded-3 p-3 bg-light-subtle">
                    <!-- Se carga dinámicamente mediante JS con las actividades del flujo o del sistema -->
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-cgr-primary rounded-pill px-4" onclick="guardarActividadesIndividuales()">
                    <i class="bi bi-save me-1"></i> Guardar Actividades del Usuario
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let filtroEstadoActual = 'todas';
        let estadoInicialCheckboxes = new Set();
        let temporizadorBusqueda = null;
        let solicitudFlujos = 0;
        let solicitudUsuarios = 0;
        let moldeCargado = '';
        let flujoCargado = '';

        document.addEventListener('change', evento => {
            if (evento.target?.classList.contains('chk-usuario-asignacion')) {
                evaluarCambiosPendientes();
            }
        });

        function obtenerCambiosPendientes() {
            return Array.from(document.querySelectorAll('.chk-usuario-asignacion'))
                .filter(checkbox => checkbox.checked !== estadoInicialCheckboxes.has(checkbox.value));
        }

        async function confirmarYDescartarCambios(accion) {
            const cantidad = obtenerCambiosPendientes().length;
            if (cantidad === 0) return true;

            const confirmado = await confirmarAccion(
                `Tiene ${cantidad} ${cantidad === 1 ? 'cambio pendiente' : 'cambios pendientes'} sin guardar. Si ${accion}, se descartarán.`,
                {
                    kind: 'warning',
                    title: 'Cambios sin guardar',
                    confirmText: 'Descartar cambios',
                    cancelText: 'Seguir editando'
                }
            );

            if (confirmado) {
                document.querySelectorAll('.chk-usuario-asignacion').forEach(checkbox => {
                    checkbox.checked = estadoInicialCheckboxes.has(checkbox.value);
                });
                evaluarCambiosPendientes();
            }

            return confirmado;
        }

        function mostrarCarga(contenedor, mensaje) {
            const estado = document.createElement('div');
            estado.className = 'responsable-loading text-center py-3';
            estado.setAttribute('role', 'status');

            const spinner = document.createElement('span');
            spinner.className = 'spinner-border spinner-border-sm text-primary me-2';

            const texto = document.createElement('span');
            texto.textContent = mensaje;
            estado.append(spinner, texto);
            contenedor.replaceChildren(estado);
            contenedor.setAttribute('aria-busy', 'true');
        }

        function establecerOpcion(select, texto, valor = '') {
            select.replaceChildren(new Option(texto, valor));
        }

        // 1. CARGAR FLUJOS POR MOLDE
        async function cargarFlujosMolde(reintentar = false) {
            const selectMolde = document.getElementById('selectMolde');
            const codigoTre = selectMolde.value;
            const selectFlujo = document.getElementById('selectFlujo');
            const btnVerFlujo = document.getElementById('btnVerActividadesFlujo');
            const estadoFlujos = document.getElementById('estadoFlujos');

            if (!reintentar && codigoTre !== moldeCargado) {
                if (!await confirmarYDescartarCambios('cambie de molde')) {
                    selectMolde.value = moldeCargado;
                    return;
                }
                moldeCargado = codigoTre;
            }

            const solicitud = ++solicitudFlujos;
            solicitudUsuarios++;
            document.getElementById('contenedorGestionUsuarios').classList.add('d-none');
            flujoCargado = '';
            document.getElementById('gridUsuariosContenedor').replaceChildren();
            estadoInicialCheckboxes.clear();
            evaluarCambiosPendientes();

            btnVerFlujo.classList.add('d-none');
            establecerOpcion(selectFlujo, '-- Seleccione un flujo --');
            selectFlujo.disabled = true;
            estadoFlujos.textContent = '';

            if (!codigoTre) return;

            establecerOpcion(selectFlujo, 'Cargando flujos…');
            try {
                const respuesta = await fetch(`/ResponsableActividad/ObtenerFlujos?codigoTre=${encodeURIComponent(codigoTre)}`, { suppressGlobalError: true });
                if (!respuesta.ok) throw new Error('No se pudieron cargar los flujos.');

                const resultado = await respuesta.json();
                if (!resultado.success) throw new Error(resultado.message || 'No se pudieron cargar los flujos.');
                if (solicitud !== solicitudFlujos) return;

                if (!resultado.data?.length) {
                    establecerOpcion(selectFlujo, 'No hay flujos disponibles para este molde.');
                    return;
                }

                const fragmento = document.createDocumentFragment();
                fragmento.appendChild(new Option('-- Seleccione un Flujo --', ''));
                resultado.data.forEach(flujo => {
                    fragmento.appendChild(new Option(flujo.nombreFlujo, flujo.nombreFlujo));
                });

                selectFlujo.replaceChildren(fragmento);
                selectFlujo.disabled = false;
                document.getElementById('seccionFlujos').scrollIntoView({ behavior: 'smooth', block: 'start' });

            } catch (error) {
                if (solicitud !== solicitudFlujos) return;
                establecerOpcion(selectFlujo, 'No se pudieron cargar los flujos.');
            }
        }

        // PREVISUALIZAR ACTIVIDADES DEL FLUJO (MODAL)
        async function previsualizarActividadesFlujo() {
            const codigoTre = document.getElementById('selectMolde').value;
            const nombreFlujo = document.getElementById('selectFlujo').value;
            const contenedor = document.getElementById('listaActividadesFlujoContenedor');

            if (!nombreFlujo) return;

            mostrarCarga(contenedor, 'Cargando actividades del flujo…');
            const modal = new bootstrap.Modal(document.getElementById('modalPrevisualizarFlujo'));
            modal.show();

            try {
                const url = `/ResponsableActividad/ObtenerActividadesPorFlujo?codigoTre=${encodeURIComponent(codigoTre)}&nombreFlujo=${encodeURIComponent(nombreFlujo)}`;
                const respuesta = await fetch(url, { suppressGlobalError: true });
                const resultado = await respuesta.json();

                if (!resultado.success || !resultado.actividades?.length) {
                    contenedor.innerHTML = '<span class="text-muted small fst-italic">No se encontraron actividades configuradas.</span>';
                    return;
                }

                const fragmento = document.createDocumentFragment();
                resultado.actividades.forEach(act => {
                    const item = document.createElement('div');
                    item.className = 'list-group-item border-0 border-bottom py-2';
                    item.innerHTML = `<i class="bi bi-check-circle-fill text-success me-2"></i><strong>${act.descripcionActividad}</strong> <span class="text-muted small">(${act.descripcionSubtipo})</span>`;
                    fragmento.appendChild(item);
                });

                contenedor.replaceChildren(fragmento);
            } catch {
                contenedor.innerHTML = '<span class="text-danger small">Error al cargar las actividades del flujo.</span>';
            }
        }

        // 2. CARGAR USUARIOS DIRECTAMENTE AL SELECCIONAR EL FLUJO
        // 2. CARGAR USUARIOS DIRECTAMENTE AL SELECCIONAR EL FLUJO
        async function cargarUsuariosPorFlujo(reintentar = false) {
            const selectFlujo = document.getElementById('selectFlujo');
            const nombreFlujo = selectFlujo.value;
            const codigoTre = document.getElementById('selectMolde').value;
            const contenedorGestion = document.getElementById('contenedorGestionUsuarios');
            const btnVerFlujo = document.getElementById('btnVerActividadesFlujo');
            const badgeFlujo = document.getElementById('lblFlujoSeleccionado');
            const spanTextoFlujo = badgeFlujo.querySelector('span.fw-bold');

            if (!reintentar && nombreFlujo !== flujoCargado) {
                if (!await confirmarYDescartarCambios('cambie de flujo')) {
                    selectFlujo.value = flujoCargado;
                    return;
                }
            }

            if (!nombreFlujo) {
                solicitudUsuarios++;
                flujoCargado = '';
                estadoInicialCheckboxes.clear();
                evaluarCambiosPendientes();
                document.getElementById('gridUsuariosContenedor').replaceChildren();
                contenedorGestion.classList.add('d-none');
                badgeFlujo.classList.add('d-none');
                btnVerFlujo.classList.add('d-none');
                return;
            }

            btnVerFlujo.classList.remove('d-none');
            spanTextoFlujo.textContent = nombreFlujo;
            badgeFlujo.classList.remove('d-none');

            const solicitud = ++solicitudUsuarios;
            const grid = document.getElementById('gridUsuariosContenedor');
            contenedorGestion.classList.remove('d-none');
            flujoCargado = '';
            estadoInicialCheckboxes.clear();
            evaluarCambiosPendientes();
            mostrarCarga(grid, 'Cargando usuarios…');

            try {
                const urlActividades = `/ResponsableActividad/ObtenerActividadesPorFlujo?codigoTre=${encodeURIComponent(codigoTre)}&nombreFlujo=${encodeURIComponent(nombreFlujo)}`;
                const respAct = await fetch(urlActividades);
                const resActJson = await respAct.json();

                if (!resActJson.success || !resActJson.actividades?.length) {
                    throw new Error('No hay actividades asociadas a este flujo.');
                }

                // Usamos la primera actividad para renderizar la lista base de usuarios del molde
                const primeraActividadId = resActJson.actividades[0].codigoActividad;

                const urlGrid = `/ResponsableActividad/ObtenerGridPorFlujo?codigoTre=${encodeURIComponent(codigoTre)}&nombreFlujo=${encodeURIComponent(nombreFlujo)}`;
                const respuesta = await fetch(urlGrid, { suppressGlobalError: true });
                if (!respuesta.ok) throw new Error('No se pudieron cargar los usuarios.');

                const html = await respuesta.text();
                if (solicitud !== solicitudUsuarios) return;

                grid.innerHTML = html;
                grid.setAttribute('aria-busy', 'false');
                flujoCargado = nombreFlujo;
                filtroEstadoActual = 'todas';
                document.getElementById('filtroBusquedaGeneral').value = '';
                actualizarBotonesFiltro();

                // IMPORTANTE: Aseguramos que el estado inicial limpie los falsos positivos
                // para que el usuario elija conscientemente a quién aplicarle el flujo masivo
                capturarEstadoInicial();
                evaluarCambiosPendientes();
                aplicarFiltrosTablaUsuarios();

                contenedorGestion.scrollIntoView({ behavior: 'smooth', block: 'start' });

            } catch (error) {
                if (solicitud !== solicitudUsuarios) return;
                const mensaje = error.message || 'Ocurrió un error al cargar los usuarios del flujo.';
                mostrarErrorModulo(grid, mensaje, () => cargarUsuariosPorFlujo(true));
            }
        }

        function capturarEstadoInicial() {
            estadoInicialCheckboxes.clear();
            document.querySelectorAll('.chk-usuario-asignacion').forEach(chk => {
                if (chk.checked) estadoInicialCheckboxes.add(chk.value);
            });
        }

        function evaluarCambiosPendientes() {
            let hayCambios = false;
            document.querySelectorAll('.chk-usuario-asignacion').forEach(chk => {
                if (chk.checked !== estadoInicialCheckboxes.has(chk.value)) hayCambios = true;
            });

            const btnGuardar = document.getElementById('btnGuardarCambios');
            if (btnGuardar) {
                btnGuardar.disabled = !hayCambios;
                if (hayCambios) btnGuardar.classList.remove('opacity-50');
                else btnGuardar.classList.add('opacity-50');
            }
            document.getElementById('estadoCambios').classList.toggle('d-none', !hayCambios);
        }

        async function guardarAsignacionFlujo() {
            const nombreFlujo = document.getElementById('selectFlujo').value;
            const codigoTre = document.getElementById('selectMolde').value;
            if (!nombreFlujo) return;

            try {
                // 1. Obtenemos todas las actividades que pertenecen a este flujo
                const urlActividades = `/ResponsableActividad/ObtenerActividadesPorFlujo?codigoTre=${encodeURIComponent(codigoTre)}&nombreFlujo=${encodeURIComponent(nombreFlujo)}`;
                const respAct = await fetch(urlActividades);
                const resActJson = await respAct.json();

                if (!resActJson.success || !resActJson.actividades?.length) {
                    mostrarBanner('No se encontraron actividades para este flujo.', 'danger');
                    return;
                }

                const listaActividades = resActJson.actividades.map(a => a.codigoActividad);

                // 2. Capturamos TODOS los usuarios que están marcados actualmente en el grid
                const listaDespaMarcados = Array.from(document.querySelectorAll('.chk-usuario-asignacion:checked')).map(chk => chk.value);

                let exitoGlobal = true;

                // 3. Enviamos la lista completa de marcados para cada actividad del flujo
                for (const codigoActividad of listaActividades) {
                    const dto = {
                        codigoActividad: codigoActividad,
                        codigoTre: parseInt(codigoTre),
                        listaCodigosDespa: listaDespaMarcados.join(',') // Todos los tildados en pantalla
                    };

                    const respuesta = await fetch('/ResponsableActividad/GuardarAsignacionInversa', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(dto),
                        suppressGlobalError: true,
                        suppressAutoSuccess: true
                    });
                    
                    const resultado = await respuesta.json();
                    if (!respuesta.ok || !resultado.success) {
                        exitoGlobal = false;
                    }
                }

                if (!exitoGlobal) {
                    mostrarBanner('Algunas actividades no pudieron actualizarse correctamente.', 'warning');
                    return;
                }

                mostrarNotificacion('¡Asignación del flujo guardada exitosamente!', 'success');
                
                // Actualizamos el estado inicial para que reconozca los nuevos checks como la "base" actual
                capturarEstadoInicial();
                evaluarCambiosPendientes();
                aplicarFiltrosTablaUsuarios();

            } catch (error) {
                mostrarBanner('No se pudieron guardar los cambios del flujo. Verifique su conexión.', 'danger');
            }
        }

        async function filtrarEstadoUsuarios(nuevoEstado) {
            if (filtroEstadoActual === nuevoEstado) return;

            const checkboxes = document.querySelectorAll('.chk-usuario-asignacion');
            const cambiosPendientesCount = obtenerCambiosPendientes().length;

            if (cambiosPendientesCount > 0) {
                const confirmar = await confirmarAccion(
                    `Tiene ${cambiosPendientesCount} ${cambiosPendientesCount === 1 ? 'cambio pendiente' : 'cambios pendientes'} sin guardar. Si cambia de filtro, se descartarán.`,
                    {
                        kind: 'warning',
                        title: 'Cambios sin guardar (' + cambiosPendientesCount + ')',
                        confirmText: 'Descartar cambios',
                        cancelText: 'Seguir editando'
                    }
                );

                if (!confirmar) return;
            }

            filtroEstadoActual = nuevoEstado;
            if (cambiosPendientesCount > 0) {
                checkboxes.forEach(checkbox => checkbox.checked = estadoInicialCheckboxes.has(checkbox.value));
                evaluarCambiosPendientes();
            }
            actualizarBotonesFiltro();
            aplicarFiltrosTablaUsuarios();
        }

        function actualizarBotonesFiltro() {
            const filtros = [
                ['btnFiltroTodas', 'todas'],
                ['btnFiltroAsignadas', 'asignadas'],
                ['btnFiltroNoAsignadas', 'no-asignadas']
            ];
            filtros.forEach(([id, estado]) => {
                const boton = document.getElementById(id);
                const activo = filtroEstadoActual === estado;
                boton.classList.toggle('active', activo);
                boton.setAttribute('aria-pressed', String(activo));
            });
        }

        function manejarBusquedaOptimizada() {
            clearTimeout(temporizadorBusqueda);
            temporizadorBusqueda = setTimeout(() => {
                aplicarFiltrosTablaUsuarios();
            }, 200);
        }

        function limpiarBusquedaUsuarios() {
            document.getElementById('filtroBusquedaGeneral').value = '';
            aplicarFiltrosTablaUsuarios();
        }

        function aplicarFiltrosTablaUsuarios() {
            const textoFiltro = document.getElementById('filtroBusquedaGeneral').value.toLowerCase().trim();
            const filas = document.querySelectorAll('#tablaUsuariosAsignacion tbody tr');
            let visiblesCount = 0;

            filas.forEach(fila => {
                const checkbox = fila.querySelector('.chk-usuario-asignacion');
                const codigoDespa = checkbox ? checkbox.value : '';
                const estaAsignadaOriginal = estadoInicialCheckboxes.has(codigoDespa);
                const textoFila = fila.getAttribute('data-search') || fila.innerText.toLowerCase();

                let cumpleEstado = true;
                if (filtroEstadoActual === 'asignadas' && !estaAsignadaOriginal) cumpleEstado = false;
                if (filtroEstadoActual === 'no-asignadas' && estaAsignadaOriginal) cumpleEstado = false;

                const cumpleTexto = !textoFiltro || textoFila.includes(textoFiltro);

                if (cumpleEstado && cumpleTexto) {
                    fila.style.display = '';
                    visiblesCount++;
                } else {
                    fila.style.display = 'none';
                }
            });

            let alertVacio = document.getElementById('alertaFiltroVacio');
            const tablaContainer = document.querySelector('#tablaUsuariosAsignacion')?.closest('.table-responsive');

            if (visiblesCount === 0) {
                if (!alertVacio && tablaContainer) {
                    alertVacio = document.createElement('div');
                    alertVacio.id = 'alertaFiltroVacio';
                    alertVacio.className = 'alert alert-secondary border-0 shadow-sm text-center py-3 rounded-3 mt-2 mb-0';
                    alertVacio.setAttribute('role', 'status');
                    const icono = document.createElement('i');
                    icono.className = 'bi bi-search fs-5 text-secondary d-block mb-1';
                    const mensaje = document.createElement('span');
                    mensaje.className = 'fw-semibold text-secondary small';
                    mensaje.textContent = 'No hay usuarios para mostrar con este filtro o búsqueda.';
                    alertVacio.append(icono, mensaje);
                    tablaContainer.parentNode.appendChild(alertVacio);
                } else if (alertVacio) {
                    alertVacio.style.display = '';
                }
            } else {
                if (alertVacio) alertVacio.style.display = 'none';
            }
        }

        // 1. ABRIR MODAL DE GESTIÓN INDIVIDUAL POR USUARIO
        // 1. ABRIR MODAL DE GESTIÓN INDIVIDUAL POR USUARIO
        async function abrirModalGestionIndividual(codigoDespa, nombreUsuario) {
            document.getElementById('txtDespaModal').value = codigoDespa;
            document.getElementById('lblNombreUsuarioModal').textContent = `${nombreUsuario} (Código: ${codigoDespa})`;

            const contenedor = document.getElementById('gridActividadesUsuarioContenedor');
            mostrarCarga(contenedor, 'Cargando actividades del usuario y del flujo…');

            const modal = new bootstrap.Modal(document.getElementById('modalGestionarUsuarioIndividual'));
            modal.show();

            const codigoTre = document.getElementById('selectMolde').value;
            const nombreFlujo = document.getElementById('selectFlujo').value;

            try {
                const urlActividadesFlujo = `/ResponsableActividad/ObtenerActividadesPorFlujo?codigoTre=${encodeURIComponent(codigoTre)}&nombreFlujo=${encodeURIComponent(nombreFlujo)}`;
                const urlActividadesUsuario = `/ResponsableActividad/ObtenerActividadesUsuario?codigoDespa=${encodeURIComponent(codigoDespa)}`;

                const [respFlujo, respUsuario] = await Promise.all([
                    fetch(urlActividadesFlujo),
                    fetch(urlActividadesUsuario)
                ]);

                const resFlujoJson = await respFlujo.json();
                const resUsrJson = await respUsuario.json();

                if (!resFlujoJson.success || !resFlujoJson.actividades?.length) {
                    contenedor.innerHTML = '<span class="text-muted small">No hay actividades disponibles en este flujo para gestionar.</span>';
                    return;
                }

                // IDs de actividades que el usuario ya tiene asignadas en base de datos
                const idsAsignadasUsuario = new Set((resUsrJson || []).map(a => a.codigoActividad));

                const fragmento = document.createDocumentFragment();
                resFlujoJson.actividades.forEach(act => {
                    const div = document.createElement('div');
                    div.className = 'form-check py-1';

                    const chk = document.createElement('input');
                    chk.className = 'form-check-input chk-actividad-individual fs-5';
                    chk.type = 'checkbox';
                    chk.value = act.codigoActividad;
                    chk.id = `act_ind_${act.codigoActividad}`;

                    // Se marcarán exclusivamente las que el usuario posea de forma real en la BD
                    if (idsAsignadasUsuario.has(act.codigoActividad)) {
                        chk.checked = true;
                    }

                    const label = document.createElement('label');
                    label.className = 'form-check-label small fw-semibold text-dark ms-1';
                    label.htmlFor = chk.id;
                    label.textContent = `${act.descripcionActividad} (${act.descripcionSubtipo})`;

                    div.append(chk, label);
                    fragmento.appendChild(div);
                });

                contenedor.replaceChildren(fragmento);

            } catch (error) {
                contenedor.innerHTML = '<span class="text-danger small">Error al cargar las actividades individuales del usuario.</span>';
            }
        }

        // 2. GUARDAR LOS CAMBIOS DEL MODAL INDIVIDUAL
        async function guardarActividadesIndividuales() {
            const codigoDespa = document.getElementById('txtDespaModal').value;
            const checkboxes = document.querySelectorAll('.chk-actividad-individual:checked');
            const listaActividades = Array.from(checkboxes).map(chk => chk.value);

            const dto = {
                codigoDespa: codigoDespa,
                listaCodigosActividades: listaActividades.join(',')
            };

            try {
                const respuesta = await fetch('/ResponsableActividad/GuardarAsignacionResponsable', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dto),
                    suppressGlobalError: true,
                    suppressAutoSuccess: true
                });

                const resultado = await respuesta.json();
                if (!respuesta.ok || !resultado.success) {
                    mostrarBanner(resultado.message || 'No se pudieron guardar las actividades del usuario.', 'danger');
                    return;
                }

                mostrarNotificacion('Actividades del usuario actualizadas exitosamente.', 'success');

                // Cerramos el modal
                const modalElement = document.getElementById('modalGestionarUsuarioIndividual');
                const modalInstance = bootstrap.Modal.getInstance(modalElement);
                if (modalInstance) modalInstance.hide();

                // Recargamos el grid principal para reflejar cambios si es necesario
                // cargarUsuariosPorFlujo(true);

            } catch (error) {
                mostrarBanner('Error de conexión al guardar las actividades individuales.', 'danger');
            }
        }

    </script>
}