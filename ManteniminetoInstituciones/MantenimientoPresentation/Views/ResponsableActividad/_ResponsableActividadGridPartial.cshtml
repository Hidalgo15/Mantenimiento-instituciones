@model List<Mantenimiento.Core.Application.DTOs.ResponsableActividad.UsuarioActividadAsignacionDto>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0" id="tablaUsuariosAsignacion">
                <thead class="bg-light text-secondary border-bottom small text-uppercase fw-bold sticky-top">
                    <tr>
                        <th class="py-3 px-3 text-center" style="width: 70px;">Asignar</th>
                        <th class="py-3 px-3">Usuario</th>
                        <th class="py-3 px-3">Cargo</th>
                        <th class="py-3 px-3">Área</th>
                        <th class="py-3 px-3 text-center" style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var searchToken = $"{user.Nombre} {user.CodigoDespa} {user.Cargo} {user.DescArea} {user.Institucion}".ToLowerInvariant();

                        <tr data-search="@searchToken">
                            <td class="text-center px-3">
                                <div class="form-check d-flex justify-content-center">
                                    <input class="form-check-input chk-usuario-asignacion fs-5" type="checkbox" value="@user.CodigoDespa" @(user.EstaAsignado ? "checked" : "") />
                                </div>
                            </td>
                            <td class="px-3">
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-dark small">@user.Nombre</span>
                                    <span class="text-muted" style="font-size: 0.75rem;">Código: <code>@user.CodigoDespa</code></span>
                                </div>
                            </td>
                            <td class="px-3 fw-semibold text-secondary small">@(string.IsNullOrEmpty(user.Cargo) ? "Sin cargo" : user.Cargo)</td>
                            <td class="px-3 text-muted small">@(string.IsNullOrEmpty(user.DescArea) ? "N/A" : user.DescArea)</td>
                            <!-- Botón de gestión individual más pequeño y estilizado -->
                            <td class="text-center px-3">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" style="font-size: 0.75rem;" onclick="abrirModalGestionIndividual('@user.CodigoDespa', '@user.Nombre')">
                                    <i class="bi bi-person-gear me-1"></i> Gestionar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary border-0 shadow-sm text-center py-4 rounded-3 mb-0" role="status">
        <i class="bi bi-people fs-3 text-secondary d-block mb-2" aria-hidden="true"></i>
        <span class="fw-semibold text-secondary">No hay usuarios disponibles.</span>
    </div>
}