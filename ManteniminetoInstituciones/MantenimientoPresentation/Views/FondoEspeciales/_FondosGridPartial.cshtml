@using Mantenimiento.Core.Application.DTOs.Fondos
@using Mantenimiento.Core.Domain.Pagination
@model PagedResult<FondoDto>

@if (Model.Items.Count > 0)
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary border-bottom small text-uppercase fw-bold">
                    <tr>
                        @* <th class="py-3 px-3">ID</th> *@
                        <th class="py-3 px-3">Fondo</th>
                        <th class="py-3 px-3">Estructura</th>
                        <th class="py-3 px-3">Descripción</th>
                        <th class="py-3 px-3">Tipo Trámite</th>
                        <th class="py-3 px-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model.Items)
                    {
                        bool esPendiente = string.IsNullOrEmpty(item.TipoTramiteContrato?.TipoTramite) || item.TipoTramiteContrato?.TipoTramite == "Pendiente";
                        <tr>
                            @* <td class="px-3 fw-bold text-secondary">@item.Id</td> *@
                            <td class="px-3 fw-bold text-dark">
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-1">@item.Fondo</span>
                            </td>
                            <td class="px-3 text-secondary">@(string.IsNullOrWhiteSpace(item.Estructura) ? "-" : item.Estructura)</td>
                            <td class="px-3 text-dark">@(string.IsNullOrWhiteSpace(item.Descripcion) ? "-" : item.Descripcion)</td>
                            <td class="px-3">
                                <span class="badge @(esPendiente ? "bg-secondary-subtle text-secondary border border-secondary-subtle" : "bg-primary-subtle text-primary border border-primary-subtle") rounded-pill px-3 py-1 fw-medium">
                                    @(esPendiente ? "Pendiente" : item.TipoTramiteContrato.TipoTramite)
                                </span>
                            </td>
                            <td class="px-3 text-center">
                                <div class="d-inline-flex flex-wrap justify-content-center gap-2">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="abrirModalEditar(@item.Id)">
                                        <i class="bi bi-pencil-square me-1"></i> Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="eliminarFondo(@item.Id)">
                                        <i class="bi bi-trash me-1"></i> Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
        <div class="text-secondary small">
            @Model.TotalCount registro(s) · Página @Model.PageNumber de @Math.Max(Model.TotalPages, 1)
        </div>
        <div class="d-flex align-items-center gap-2">
            <label for="tamanoPaginaFondos" class="form-label small mb-0">Registros por página</label>
            <select id="tamanoPaginaFondos" class="form-select form-select-sm w-auto" data-action="cambiar-tamano-pagina">
                @foreach (var size in new[] { 10, 25, 50, 100 })
                {
                    <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                }
            </select>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="pagina-anterior" data-page="@(Model.PageNumber - 1)" disabled="@(!Model.HasPreviousPage)">
                Anterior
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="pagina-siguiente" data-page="@(Model.PageNumber + 1)" disabled="@(!Model.HasNextPage)">
                Siguiente
            </button>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary border-0 shadow-sm text-center py-5 rounded-3 mb-0" style="background-color: #f8fafc;">
        <i class="bi bi-folder-x fs-2 text-secondary d-block mb-2"></i>
        <span class="fw-semibold text-secondary">No se encontraron fondos especiales registrados.</span>
    </div>
    <div class="text-secondary small mt-3">
        @Model.TotalCount registro(s) · Página @Model.PageNumber de @Math.Max(Model.TotalPages, 1)
    </div>
}