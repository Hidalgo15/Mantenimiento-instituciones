@using Mantenimiento.Core.Application.DTOs.UnidadEjecutora
@model IEnumerable<UnidadEjecutoraDto>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-dark border-bottom">
                    <tr>
                        <th class="py-3 px-3" style="width: 6%;">ID</th>
                        <th class="py-3 px-3" style="width: 18%;">DAF</th>
                        <th class="py-3 px-3" style="width: 10%;">Código UE</th>
                        <th class="py-3 px-3" style="width: 22%;">Unidad Ejecutora</th>
                        <th class="py-3 px-3" style="width: 16%;">Categoría</th>
                        <th class="py-3 px-3" style="width: 10%;">RNC</th>
                        <th class="py-3 px-3 text-center" style="width: 8%;">Estado</th>
                        <th class="py-3 px-3 text-center" style="width: 10%;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-3 fw-bold text-secondary">@item.Id</td>
                            <td class="px-3">
                                <small class="fw-bold text-dark">@item.CodigoDaf</small> - <span class="text-muted">@item.NombreDaf</span>
                            </td>
                            <td class="px-3">
                                <span class="badge bg-light text-dark border">@item.CodigoUnidadEjecutora</span>
                            </td>
                            <td class="px-3 fw-bold text-dark">@item.NombreUnidadEjecutora</td>
                            
                            @* Celda de Categoría recuperada directamente desde el SP *@
                            <td class="px-3">
                                @(string.IsNullOrEmpty(item.DescripcionCategoria) ? "-" : item.DescripcionCategoria)
                            </td>

                            <td class="px-3">
                                @(string.IsNullOrEmpty(item.Rnc) ? "-" : item.Rnc)
                            </td>

                            <td class="px-3 text-center">
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Inactivo</span>
                                }
                            </td>

                            <td class="px-3 text-center">
                                <button class="btn btn-sm btn-outline-primary rounded-2 me-1" onclick="abrirModalEditar(@item.Id)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-2" onclick="eliminarUnidad(@item.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning border-0 shadow-sm text-center py-4 rounded-3 mb-0">
        <i class="bi bi-exclamation-triangle fs-3 text-warning d-block mb-2"></i>
        <span class="fw-semibold">No se encontraron unidades ejecutoras registradas.</span>
    </div>
}