@using Mantenimiento.Core.Application.DTOs.Daf
@using Mantenimiento.Core.Application.DTOs.UnidadEjecutora
@{
    ViewData["Title"] = "Gestión de Unidades Ejecutoras";
    var dafs = ViewBag.Dafs as IEnumerable<DafDto> ?? new List<DafDto>();
    var categorias = ViewBag.Categorias as IEnumerable<CategoriaTramiteDto> ?? new List<CategoriaTramiteDto>();
}

<div class="container-fluid py-3">
    <!-- CABECERA SUPERIOR -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-0 text-dark">Gestión de Unidades Ejecutoras</h4>
            <small class="text-muted">Administre y consulte las unidades ejecutoras por DAF</small>
        </div>
        <span class="badge text-white py-2 px-3 fs-6 rounded-pill" style="background-color: #0d5493;">
            <i class="bi bi-building me-1"></i> Institucional
        </span>
    </div>

    <!-- TARJETA DE FILTRO Y ACCIONES -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <div class="row align-items-end g-3">
                <div class="col-md-8">
                    <label for="selectDafFiltro" class="form-label fw-bold text-dark mb-2">
                        <i class="bi bi-funnel me-1" style="color: #0d5493;"></i> Filtrar por DAF
                    </label>
                    <div class="position-relative mb-2">
                        <div class="input-group">
                            <input type="text" id="txtBuscarDafFiltro" class="form-control rounded-start-pill border-secondary-subtle"
                                   placeholder="Buscar DAF por código o nombre..." aria-label="Buscar DAF"
                                   oninput="filtrarOpcionesSelect(this, 'selectDafFiltro', 'resultadosBusquedaDaf')" />
                            <button type="button" class="btn btn-outline-secondary rounded-end-pill px-3"
                                    onclick="limpiarBusquedaSelect('txtBuscarDafFiltro', 'selectDafFiltro', 'resultadosBusquedaDaf')"
                                    title="Limpiar búsqueda" aria-label="Limpiar búsqueda de DAF">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <div id="resultadosBusquedaDaf" class="list-group position-absolute top-100 start-0 w-100 shadow d-none"
                             style="z-index: 1050; max-height: 18rem; overflow-y: auto;" role="listbox"></div>
                    </div>
                    <select id="selectDafFiltro" class="form-select form-select-lg rounded-pill fs-6 border-secondary-subtle" onchange="cargarGrid()">
                        <option value="">-- Todas las DAF --</option>
                        @foreach (var d in dafs)
                        {
                            <option value="@d.Id">@d.CodigoDaf - @d.Daf</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 text-end">
                    <button type="button" id="btnNuevaUnidad" class="btn btn-cgr-primary btn-lg w-100 rounded-pill py-2" onclick="abrirModalCrear()">
                        <i class="bi bi-plus-circle me-2"></i> Nueva Unidad Ejecutora
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENEDOR DEL GRID -->
    <div id="contenedorGrid">
        <div class="text-center py-5 bg-white rounded-3 border shadow-sm">
            <div class="spinner-border text-primary mb-3" style="width: 2.5rem; height: 2.5rem;" role="status"></div>
            <p class="text-muted mb-0 fw-semibold">Cargando registros...</p>
        </div>
    </div>
</div>

<!-- MODAL CREAR / EDITAR UNIDAD EJECUTORA -->
<div class="modal fade" id="modalUnidad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white px-4 py-3" style="background-color: #0d5493;">
                <h5 class="modal-title fw-bold" id="modalUnidadTitle">
                    <i class="bi bi-plus-circle me-2"></i> Agregar Unidad Ejecutora
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formUnidad">
                    <input type="hidden" id="txtId" value="0" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-dark">DAF Pertenece</label>
                            <select id="selectDafModal" class="form-select border-secondary-subtle rounded-3" required>
                                <option value="">-- Seleccione DAF --</option>
                                @foreach (var d in dafs)
                                {
                                    <option value="@d.Id">@d.CodigoDaf - @d.Daf</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-dark">Categoría Trámite</label>
                            <select id="selectCategoriaModal" class="form-select border-secondary-subtle rounded-3" required>
                                <option value="">-- Seleccione Categoría --</option>
                                @foreach (var c in categorias)
                                {
                                    <option value="@c.CodigoCategoria">@c.Descripcion</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-dark">Código Unidad Ejecutora</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="bi bi-hash text-muted"></i></span>
                                <input type="text" id="txtCodigoUE" class="form-control rounded-end-3" required maxlength="10" placeholder="Ej: 0001" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Nombre Unidad Ejecutora</label>
                        <input type="text" id="txtNombreUE" class="form-control rounded-3" required maxlength="250" placeholder="Ej: SENADO DE LA REPUBLICA DOMINICANA" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-dark">RNC</label>
                            <input type="text" id="txtRnc" class="form-control rounded-3" maxlength="20" placeholder="Ej: 401000123" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="chkPortalCompra">
                                <label class="form-check-label fw-bold text-dark" for="chkPortalCompra">Portal Compra</label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="chkEstado" checked>
                                <label class="form-check-label fw-bold text-dark" for="chkEstado">Estado Activo</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-top-0 px-4 py-3">
                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-cgr-primary px-4 rounded-pill" onclick="guardarUnidad()">
                    <i class="bi bi-check-circle me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalUnidadBs;

        document.addEventListener('DOMContentLoaded', () => {
            modalUnidadBs = new bootstrap.Modal(document.getElementById('modalUnidad'));
            cargarGrid();
        });

        function cargarGrid() {
            const idDaf = document.getElementById('selectDafFiltro').value;
            const contenedor = document.getElementById('contenedorGrid');

            contenedor.innerHTML = `
                <div class="text-center py-5 bg-white rounded-3 border shadow-sm">
                    <div class="spinner-border text-primary mb-3" style="width: 2.5rem; height: 2.5rem;" role="status"></div>
                    <p class="text-muted mb-0 fw-semibold">Cargando registros...</p>
                </div>`;

            fetch(`/UnidadEjecutora/ObtenerGrid?idDaf=${encodeURIComponent(idDaf)}`)
                .then(res => {
                    if (!res.ok) throw new Error('Error de comunicación con el servidor');
                    return res.text();
                })
                .then(html => {
                    contenedor.innerHTML = html;
                })
                .catch(err => {
                    console.error(err);
                    contenedor.innerHTML = `
                        <div class="alert alert-danger border shadow-sm text-center py-4 rounded-3 mb-0">
                            <i class="bi bi-exclamation-octagon fs-3 d-block mb-2"></i>
                            <span class="fw-semibold">Error al cargar los datos.</span>
                        </div>`;
                });
        }

        function abrirModalCrear() {
            document.getElementById('modalUnidadTitle').innerHTML = '<i class="bi bi-plus-circle me-2"></i> Agregar Unidad Ejecutora';
            document.getElementById('txtId').value = '0';
            document.getElementById('selectDafModal').value = document.getElementById('selectDafFiltro').value || '';
            document.getElementById('selectCategoriaModal').value = '';
            document.getElementById('txtCodigoUE').value = '';
            document.getElementById('txtNombreUE').value = '';
            document.getElementById('txtRnc').value = '';
            document.getElementById('chkPortalCompra').checked = false;
            document.getElementById('chkEstado').checked = true;

            modalUnidadBs.show();
        }

        function abrirModalEditar(id) {
            fetch(`/UnidadEjecutora/ObtenerPorId?id=${id}`)
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        const data = res.data;
                        document.getElementById('modalUnidadTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i> Editar Unidad Ejecutora';
                        document.getElementById('txtId').value = data.id;
                        document.getElementById('selectDafModal').value = data.idDaf;
                        document.getElementById('selectCategoriaModal').value = data.idCategoria || '';
                        document.getElementById('txtCodigoUE').value = data.codigoUnidadEjecutora;
                        document.getElementById('txtNombreUE').value = data.nombreUnidadEjecutora;
                        document.getElementById('txtRnc').value = data.rnc || '';
                        document.getElementById('chkPortalCompra').checked = data.portalCompra;
                        document.getElementById('chkEstado').checked = data.estado;

                        modalUnidadBs.show();
                    } else {
                        alert('Error: ' + res.message);
                    }
                });
        }

        function guardarUnidad() {
            const id = parseInt(document.getElementById('txtId').value) || 0;
            const esEdicion = id > 0;
            const idDaf = parseInt(document.getElementById('selectDafModal').value) || 0;
            const idCategoria = parseInt(document.getElementById('selectCategoriaModal').value) || 0;
            const codigo = document.getElementById('txtCodigoUE').value.trim();
            const nombre = document.getElementById('txtNombreUE').value.trim();
            const rnc = document.getElementById('txtRnc').value.trim();

            if (idDaf <= 0) {
                alert('Debe seleccionar una DAF válida.');
                return;
            }
            if (idCategoria <= 0) {
                alert('Debe seleccionar una Categoría válida.');
                return;
            }
            if (!codigo) {
                alert('El código de la unidad ejecutora es obligatorio.');
                return;
            }
            if (codigo.length > 10) {
                alert('El código no puede exceder los 10 caracteres.');
                return;
            }
            if (!nombre) {
                alert('El nombre de la unidad ejecutora es obligatorio.');
                return;
            }
            if (nombre.length > 250) {
                alert('El nombre no puede exceder los 250 caracteres.');
                return;
            }
            if (rnc && rnc.length > 9) {
                alert('El RNC no puede exceder los 9 caracteres.');
                return;
            }

            const dto = {
                id: id,
                idDaf: idDaf,
                idCategoria: idCategoria,
                codigoUnidadEjecutora: codigo,
                nombreUnidadEjecutora: nombre,
                rnc: rnc || null,
                portalCompra: document.getElementById('chkPortalCompra').checked,
                estado: document.getElementById('chkEstado').checked
            };

            const endpoint = esEdicion ? '/UnidadEjecutora/Actualizar' : '/UnidadEjecutora/Crear';

            fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    modalUnidadBs.hide();
                    cargarGrid();
                } else {
                    alert(data.message || 'Ocurrió un problema al procesar la solicitud.');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Error al conectar con el servidor.');
            });
        }

        function eliminarUnidad(id) {
            if (!confirm('¿Desea desactivar esta unidad ejecutora?')) return;

            fetch(`/UnidadEjecutora/Eliminar?id=${id}`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        cargarGrid();
                    } else {
                        alert('Error al desactivar: ' + data.message);
                    }
                });
        }
    </script>
}