@{
    ViewData["Title"] = "Impedimentos";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-0 text-dark">Mantenimiento de Impedimentos</h4>
            <small class="text-muted">Consulte, registre y administre personas o entidades con impedimentos.</small>
        </div>
        <span class="badge text-white py-2 px-3 fs-6 rounded-pill" style="background-color: #0d5493;">
            <i class="bi bi-shield-exclamation me-1"></i> Control
        </span>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <div class="row align-items-end g-3">
                <div class="col-md-8">
                    <label for="filtroImpedimentos" class="form-label fw-bold text-dark">Buscar impedimentos</label>
                    <input type="search" id="filtroImpedimentos" class="form-control form-control-lg rounded-pill"
                           placeholder="Buscar por nombre, cédula/RNC o motivo" autocomplete="off" maxlength="255" />
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-cgr-primary btn-lg w-100 rounded-pill" onclick="abrirModalCrear()">
                        <i class="bi bi-plus-circle me-2"></i> Nuevo impedimento
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="contenedorGridImpedimentos">
        <div class="text-center py-5 bg-white rounded-3 border shadow-sm">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted mb-0 fw-semibold">Cargando impedimentos...</p>
        </div>
    </div>
</div>

<div class="modal fade" id="modalImpedimento" tabindex="-1" aria-labelledby="modalImpedimentoTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white px-4 py-3" style="background-color: #0d5493;">
                <h5 class="modal-title fw-bold" id="modalImpedimentoTitle">Nuevo impedimento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formImpedimento">
                    <input type="hidden" id="impedimentoId" value="0" />
                    <div class="mb-3">
                        <label for="impedimentoNombres" class="form-label fw-bold">Nombres</label>
                        <input type="text" id="impedimentoNombres" class="form-control" maxlength="255" />
                    </div>
                    <div class="mb-3">
                        <label for="impedimentoCedulaRnc" class="form-label fw-bold">Cédula / RNC</label>
                        <input type="text" id="impedimentoCedulaRnc" class="form-control" maxlength="15" />
                    </div>
                    <div class="mb-3">
                        <label for="impedimentoMotivo" class="form-label fw-bold">Motivo</label>
                        <textarea id="impedimentoMotivo" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="impedimentoEstado" checked />
                        <label class="form-check-label fw-semibold" for="impedimentoEstado">Impedimento activo</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-top-0 px-4 py-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-cgr-primary rounded-pill px-4" onclick="guardarImpedimento()">
                    <i class="bi bi-check-circle me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalImpedimento;
        let paginaImpedimentos = 1;
        let temporizadorBusquedaImpedimentos;

        document.addEventListener('DOMContentLoaded', () => {
            modalImpedimento = new bootstrap.Modal(document.getElementById('modalImpedimento'));
            document.getElementById('filtroImpedimentos').addEventListener('input', () => {
                window.clearTimeout(temporizadorBusquedaImpedimentos);
                temporizadorBusquedaImpedimentos = window.setTimeout(() => cargarImpedimentos(1), 250);
            });
            cargarImpedimentos();
        });

        async function cargarImpedimentos(pagina = paginaImpedimentos) {
            paginaImpedimentos = pagina;
            const contenedor = document.getElementById('contenedorGridImpedimentos');
            const filtroTexto = document.getElementById('filtroImpedimentos').value.trim();
            const selectorTamanoPagina = document.getElementById('tamanoPaginaImpedimentos');
            const tamanoPagina = selectorTamanoPagina ? selectorTamanoPagina.value : '10';
            const parametros = new URLSearchParams({ filtroTexto, pagina: String(pagina), tamanoPagina });
            contenedor.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="text-muted mt-3">Cargando impedimentos...</p></div>';

            try {
                const respuesta = await fetch(`/Impedimentos/ObtenerGrid?${parametros}`);
                if (!respuesta.ok) throw new Error('No se pudo cargar el listado.');
                contenedor.innerHTML = await respuesta.text();
            } catch (error) {
                console.error(error);
                contenedor.innerHTML = '<div class="alert alert-danger">No se pudo cargar el listado de impedimentos. Intente nuevamente.</div>';
            }
        }

        function cambiarPaginaImpedimentos(pagina) {
            cargarImpedimentos(pagina);
        }

        function abrirModalCrear() {
            document.getElementById('formImpedimento').reset();
            document.getElementById('impedimentoId').value = '0';
            document.getElementById('impedimentoEstado').checked = true;
            document.getElementById('modalImpedimentoTitle').textContent = 'Nuevo impedimento';
            modalImpedimento.show();
        }

        async function abrirModalEditar(id) {
            try {
                const respuesta = await fetch(`/Impedimentos/ObtenerPorId?id=${id}`);
                const resultado = await respuesta.json();
                if (!respuesta.ok || !resultado.success) throw new Error(resultado.message || 'No se pudo obtener el impedimento.');

                const impedimento = resultado.data;
                document.getElementById('impedimentoId').value = impedimento.id;
                document.getElementById('impedimentoNombres').value = impedimento.nombres || '';
                document.getElementById('impedimentoCedulaRnc').value = impedimento.cedulaRnc || '';
                document.getElementById('impedimentoMotivo').value = impedimento.motivo || '';
                document.getElementById('impedimentoEstado').checked = impedimento.estado === true;
                document.getElementById('modalImpedimentoTitle').textContent = 'Editar impedimento';
                modalImpedimento.show();
            } catch (error) {
                console.error(error);
                alert(error.message || 'No se pudo obtener el impedimento.');
            }
        }

        async function guardarImpedimento() {
            const id = Number.parseInt(document.getElementById('impedimentoId').value, 10);
            const dto = {
                id,
                nombres: document.getElementById('impedimentoNombres').value,
                cedulaRnc: document.getElementById('impedimentoCedulaRnc').value,
                motivo: document.getElementById('impedimentoMotivo').value,
                estado: document.getElementById('impedimentoEstado').checked
            };
            const esEdicion = id > 0;

            try {
                const respuesta = await fetch(`/Impedimentos/${esEdicion ? 'Actualizar' : 'Crear'}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dto)
                });
                const resultado = await respuesta.json();
                if (!respuesta.ok || !resultado.success) throw new Error(resultado.message || 'No se pudo guardar el impedimento.');
                modalImpedimento.hide();
                await cargarImpedimentos(esEdicion ? paginaImpedimentos : 1);
            } catch (error) {
                console.error(error);
                alert(error.message || 'No se pudo guardar el impedimento.');
            }
        }

        async function eliminarImpedimento(id) {
            if (!await confirmarAccion('¿Desea deshabilitar este impedimento?', { kind: 'danger', confirmText: 'Sí, deshabilitar' })) return;

            try {
                const respuesta = await fetch(`/Impedimentos/Eliminar?id=${id}`, { method: 'POST' });
                const resultado = await respuesta.json();
                if (!respuesta.ok || !resultado.success) throw new Error(resultado.message || 'No se pudo deshabilitar el impedimento.');
                await cargarImpedimentos(paginaImpedimentos);
            } catch (error) {
                console.error(error);
                alert(error.message || 'No se pudo deshabilitar el impedimento.');
            }
        }
    </script>
}
