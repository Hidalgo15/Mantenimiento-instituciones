@using Mantenimiento.Core.Application.DTOs.Impedimentos
@using Mantenimiento.Core.Domain.Pagination
@model PagedResult<ImpedimentoDto>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    @if (Model.Items.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase">
                    <tr>
                        <th class="py-3 px-3">Nombre</th>
                        <th class="py-3 px-3">Cédula / RNC</th>
                        <th class="py-3 px-3">Motivo</th>
                        <th class="py-3 px-3">Agregado por</th>
                        <th class="py-3 px-3">Fecha</th>
                        <th class="py-3 px-3 text-center">Estado</th>
                        <th class="py-3 px-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="px-3 fw-semibold">@(!string.IsNullOrWhiteSpace(item.Nombres) ? item.Nombres : "—")</td>
                            <td class="px-3">@(!string.IsNullOrWhiteSpace(item.CedulaRnc) ? item.CedulaRnc : "—")</td>
                            <td class="px-3" style="min-width: 220px;">@(!string.IsNullOrWhiteSpace(item.Motivo) ? item.Motivo : "—")</td>
                            <td class="px-3">@(!string.IsNullOrWhiteSpace(item.UsuarioAgrego) ? item.UsuarioAgrego : "—")</td>
                            <td class="px-3 text-nowrap">@(item.FechaAgrego?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="px-3 text-center">
                                @if (item.Estado == true)
                                {
                                    <span class="badge bg-success-subtle text-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="px-3 text-center text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="abrirModalEditar(@item.Id)">
                                    <i class="bi bi-pencil-square me-1"></i> Editar
                                </button>
                                @if (item.Estado == true)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="eliminarImpedimento(@item.Id)">
                                        <i class="bi bi-slash-circle me-1"></i> Deshabilitar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-secondary text-center py-5 rounded-0 mb-0">
            <i class="bi bi-search fs-2 text-secondary d-block mb-2"></i>
            <span class="fw-semibold text-secondary">No se encontraron impedimentos.</span>
        </div>
    }
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 p-3 border-top">
        <small class="text-muted">@Model.TotalCount registro(s) · Página @Model.PageNumber de @Model.TotalPages</small>
        <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
            <label for="tamanoPaginaImpedimentos" class="form-label mb-0 text-nowrap">Registros por página</label>
            <select id="tamanoPaginaImpedimentos" class="form-select form-select-sm" style="width: auto;" aria-label="Registros por página"
                    onchange="cargarImpedimentos(1)">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                <option value="100" selected="@(Model.PageSize == 100)">100</option>
            </select>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cambiarPaginaImpedimentos(@(Model.PageNumber - 1))" disabled="@(!Model.HasPreviousPage)">Anterior</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cambiarPaginaImpedimentos(@(Model.PageNumber + 1))" disabled="@(!Model.HasNextPage)">Siguiente</button>
            </div>
        </div>
    </div>
</div>
