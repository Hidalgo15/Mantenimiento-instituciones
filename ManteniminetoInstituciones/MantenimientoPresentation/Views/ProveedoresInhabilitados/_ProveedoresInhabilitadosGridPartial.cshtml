@using Mantenimiento.Core.Application.DTOs.ProveedoresInhabilitados
@using Mantenimiento.Core.Domain.Pagination
@model PagedResult<ProveedorInhabilitadoDto>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    @if (Model.Items.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0" style="min-width: 900px;">
                <thead class="bg-light text-secondary small text-uppercase">
                    <tr>
                        <th class="py-3 px-3" style="width: 23%;">Proveedor</th>
                        <th class="py-3 px-3" style="width: 16%;">Perfil</th>
                        <th class="py-3 px-3" style="width: 16%;">Fechas</th>
                        <th class="py-3 px-3" style="width: 14%;">Estado RPE</th>
                        <th class="py-3 px-3" style="width: 19%;">Motivo</th>
                        <th class="py-3 px-3 text-center position-sticky end-0 bg-light" style="width: 12%; min-width: 130px; z-index: 2;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="px-3">
                                <div class="fw-semibold text-break">@(!string.IsNullOrWhiteSpace(item.RazonSocial) ? item.RazonSocial : "—")</div>
                                <small class="text-muted d-block">RPE: @(!string.IsNullOrWhiteSpace(item.Rpe) ? item.Rpe : "—")</small>
                                <small class="text-muted d-block">
                                    @(!string.IsNullOrWhiteSpace(item.TipoDocumento) ? item.TipoDocumento : "Documento"):
                                    @(!string.IsNullOrWhiteSpace(item.NumeroDocumento) ? item.NumeroDocumento : "—")
                                </small>
                            </td>
                            <td class="px-3">
                                <div>@(!string.IsNullOrWhiteSpace(item.TipoPersona) ? item.TipoPersona : "—")</div>
                                <small class="text-muted">Género: @(!string.IsNullOrWhiteSpace(item.Genero) ? item.Genero : "—")</small>
                            </td>
                            <td class="px-3">
                                <small class="text-muted d-block">Registro: @(!string.IsNullOrWhiteSpace(item.FechaRegistro) ? item.FechaRegistro : "—")</small>
                                <small class="text-muted d-block">Actualización: @(!string.IsNullOrWhiteSpace(item.FechaUltimaActualizacion) ? item.FechaUltimaActualizacion : "—")</small>
                            </td>
                            <td class="px-3 text-break">@(!string.IsNullOrWhiteSpace(item.EstadoRpe) ? item.EstadoRpe : "—")</td>
                            <td class="px-3 text-break" title="@item.MotivoInhabilitacion">
                                @(!string.IsNullOrWhiteSpace(item.MotivoInhabilitacion) ? item.MotivoInhabilitacion : "—")
                            </td>
                            <td class="px-3 text-center position-sticky end-0 bg-white" style="min-width: 130px; z-index: 1;">
                                <div class="d-flex flex-column gap-1">
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="abrirModalEditarProveedor(@item.Id)" aria-label="Editar proveedor @item.RazonSocial">
                                    <i class="bi bi-pencil-square me-1"></i> Editar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarProveedor(@item.Id)" aria-label="Eliminar proveedor @item.RazonSocial">
                                    <i class="bi bi-trash me-1"></i> Eliminar
                                </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-secondary text-center py-5 rounded-0 mb-0">
            <i class="bi bi-search fs-2 text-secondary d-block mb-2"></i>
            <span class="fw-semibold text-secondary">No se encontraron proveedores inhabilitados.</span>
        </div>
    }
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 p-3 border-top">
        <small class="text-muted">@Model.TotalCount registro(s) · Página @Model.PageNumber de @Model.TotalPages</small>
        <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
            <label for="tamanoPaginaProveedores" class="form-label mb-0 text-nowrap">Registros por página</label>
            <select id="tamanoPaginaProveedores" class="form-select form-select-sm" style="width: auto;" aria-label="Registros por página"
                    onchange="cargarProveedores(1)">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                <option value="100" selected="@(Model.PageSize == 100)">100</option>
            </select>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cambiarPaginaProveedores(@(Model.PageNumber - 1))" disabled="@(!Model.HasPreviousPage)">Anterior</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="cambiarPaginaProveedores(@(Model.PageNumber + 1))" disabled="@(!Model.HasNextPage)">Siguiente</button>
            </div>
        </div>
    </div>
</div>
