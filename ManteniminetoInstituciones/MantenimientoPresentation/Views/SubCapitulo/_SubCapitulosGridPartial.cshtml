@using Mantenimiento.Core.Application.DTOs.SubCapitulo
@model List<SubCapituloDto>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary border-bottom small text-uppercase fw-bold">
                    <tr>
                        <th class="py-3 px-3">ID</th>
                        <th class="py-3 px-3">Código</th>
                        <th class="py-3 px-3">Subcapítulo</th>
                        <th class="py-3 px-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-3 fw-bold text-secondary">@item.Id</td>
                            <td class="px-3">
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-1">@item.CodigoSubCapitulo</span>
                            </td>
                            <td class="px-3 fw-bold text-dark">@item.subcapitulo</td>
                            <td class="px-3 text-center">
                                <div class="d-inline-flex flex-wrap justify-content-center gap-2">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="abrirModalEditar(@item.Id, @item.IdCapitulo)">
                                        <i class="bi bi-pencil-square me-1"></i> Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="eliminarSubCapitulo(@item.Id)">
                                        <i class="bi bi-trash me-1"></i> Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary border-0 shadow-sm text-center py-5 rounded-3 mb-0" style="background-color: #f8fafc;">
        <i class="bi bi-diagram-2 fs-2 text-secondary d-block mb-2"></i>
        <span class="fw-semibold text-secondary">No se encontraron subcapítulos registrados.</span>
    </div>
}