@using Mantenimiento.Core.Application.DTOs.RelacionContratoRequisito
@{
    ViewData["Title"] = "Relación de Contratos y Requisitos";
    var clasificaciones = ViewBag.Clasificaciones as List<CatalogoClasificacionContratoDto> ?? new List<CatalogoClasificacionContratoDto>();
    var requisitos = ViewBag.Requisitos as List<CatalogoRequisitoContratoDto> ?? new List<CatalogoRequisitoContratoDto>();
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-0 text-dark">Gestión de Requisitos por Clasificación de Contrato</h4>
            <small class="text-muted">Asigne y administre los requisitos documentales requeridos para cada contrato</small>
        </div>
        <span class="badge text-white py-2 px-3 fs-6 rounded-pill" style="background-color: #0d5493;">
            <i class="bi bi-link-45deg me-1"></i> Contratos
        </span>
    </div>

    <!-- TARJETA DE FILTROS Y BÚSQUEDA FLOTANTE -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4 bg-white rounded-3">
            <div class="row align-items-end g-3">
                <!-- Buscador con lista flotante (Idéntico al ejemplo que funciona) -->
                <div class="col-md-12 mb-2">
                    <label for="txtFiltroBusqueda" class="form-label fw-bold text-dark mb-2">
                        <i class="bi bi-search me-1" style="color: #0d5493;"></i> Buscar por Tipo de Contrato o Requisito
                    </label>
                    <div class="position-relative">
                        <div class="input-group">
                            <input type="text" id="txtFiltroBusqueda" class="form-control rounded-start-pill border-secondary-subtle" 
                                   placeholder="Escriba para buscar..." 
                                   oninput="filtrarFiltroFlotante(this)" autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary rounded-end-pill px-3" 
                                    onclick="limpiarFiltroBusqueda()" title="Limpiar búsqueda">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <!-- Lista flotante de sugerencias -->
                        <div id="resultadosFiltroFlotante" class="list-group position-absolute top-100 start-0 w-100 shadow d-none"
                             style="z-index: 1050; max-height: 15rem; overflow-y: auto; background-color: white;"></div>
                    </div>
                </div>

                <div class="col-md-5">
                    <label class="form-label fw-bold text-dark mb-2">
                        <i class="bi bi-funnel me-1" style="color: #0d5493;"></i> Clasificación de Contrato
                    </label>
                    <select id="filtroCodigoClasificacion" class="form-select rounded-pill border-secondary-subtle" onchange="cargarGrid()">
                        <option value="">-- Todas las clasificaciones --</option>
                        @foreach (var c in clasificaciones)
                        {
                            <option value="@c.CodigoClasificacion">@c.ContratoTipo - @c.TipoOperacion (@c.ContratoProcesoSeleccion)</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-bold text-dark mb-2">
                        <i class="bi bi-funnel me-1" style="color: #0d5493;"></i> Requisito
                    </label>
                    <select id="filtroCodigoRequisito" class="form-select rounded-pill border-secondary-subtle" onchange="cargarGrid()">
                        <option value="">-- Todos los requisitos --</option>
                        @foreach (var r in requisitos)
                        {
                            <option value="@r.CodigoRequisito">@r.DescripcionRequisito</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button type="button" class="btn btn-outline-secondary w-100 rounded-pill py-2" onclick="limpiarFiltros()">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Botón Nueva Relación -->
    <div class="mb-3 text-end">
        <button type="button" class="btn btn-cgr-primary rounded-pill px-4 py-2" onclick="abrirModalCrear()">
            <i class="bi bi-plus-circle me-1"></i> Nueva Relación
        </button>
    </div>

    <!-- Contenedor Grid -->
    <div id="contenedorGrid">
        <div class="text-center py-5 bg-white rounded-3 border shadow-sm">
            <div class="spinner-border text-primary mb-3" style="width: 2.5rem; height: 2.5rem;" role="status"></div>
            <p class="text-muted mb-0 fw-semibold">Cargando relaciones...</p>
        </div>
    </div>
</div>

<!-- Modal Registro / Edición -->
<div class="modal fade" id="modalMantenimiento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white px-4 py-3" style="background-color: #0d5493;">
                <h5 class="modal-title fw-bold" id="modalTitle">Asignar Requisito a Contrato</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formMantenimiento">
                    <input type="hidden" id="hdnId" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Clasificación de Contrato</label>
                        <select id="modalCodigoClasificacion" class="form-select rounded-3" required>
                            <option value="">-- Seleccione una clasificación --</option>
                            @foreach (var c in clasificaciones)
                            {
                                <option value="@c.CodigoClasificacion">@c.ContratoTipo - @c.TipoOperacion (@c.ContratoProcesoSeleccion)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Requisito</label>
                        <select id="modalCodigoRequisito" class="form-select rounded-3" required>
                            <option value="">-- Seleccione un requisito --</option>
                            @foreach (var r in requisitos)
                            {
                                <option value="@r.CodigoRequisito">@r.DescripcionRequisito</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-top-0 px-4 py-3">
                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-cgr-primary px-4 rounded-pill" onclick="guardarRelacion()">
                    <i class="bi bi-check-circle me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalBs;
        document.addEventListener('DOMContentLoaded', () => {
            modalBs = new bootstrap.Modal(document.getElementById('modalMantenimiento'));
            cargarGrid();
        });

        function cargarGrid(busqueda = '') {
            const codigoClasificacion = document.getElementById('filtroCodigoClasificacion').value;
            const codigoRequisito = document.getElementById('filtroCodigoRequisito').value;

            const params = new URLSearchParams({ codigoClasificacion, codigoRequisito, busqueda });

            fetch(`/RelacionContratoRequisito/ObtenerGrid?${params.toString()}`)
                .then(res => res.text())
                .then(html => document.getElementById('contenedorGrid').innerHTML = html);
        }

        // Función de búsqueda flotante robusta basada en las opciones de los selectores
        function filtrarFiltroFlotante(input) {
            const normalizar = texto => texto
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLocaleLowerCase();

            const query = normalizar(input.value.trim());
            const contenedorResultados = document.getElementById('resultadosFiltroFlotante');
            contenedorResultados.replaceChildren();

            if (!query) {
                contenedorResultados.classList.add('d-none');
                return;
            }

            // Recopilamos sugerencias directamente de los elementos del DOM disponibles en los selects (Clasificaciones y Requisitos)
            const sugerenciasMap = new Map();

            const selectClasificacion = document.getElementById('filtroCodigoClasificacion');
            Array.from(selectClasificacion?.options || []).forEach(opt => {
                if (opt.value && normalizar(opt.text).includes(query)) {
                    sugerenciasMap.set(opt.text, { texto: opt.text, tipo: 'clasificacion', valor: opt.value });
                }
            });

            const selectRequisito = document.getElementById('filtroCodigoRequisito');
            Array.from(selectRequisito?.options || []).forEach(opt => {
                if (opt.value && normalizar(opt.text).includes(query)) {
                    sugerenciasMap.set(opt.text, { texto: opt.text, tipo: 'requisito', valor: opt.value });
                }
            });

            const sugerencias = Array.from(sugerenciasMap.values()).slice(0, 50);

            if (sugerencias.length === 0) {
                const vacio = document.createElement('div');
                vacio.className = 'list-group-item text-muted small';
                vacio.textContent = 'No se encontraron coincidencias.';
                contenedorResultados.appendChild(vacio);
            } else {
                sugerencias.forEach(item => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'list-group-item list-group-item-action text-start';
                    btn.textContent = item.texto;
                    btn.addEventListener('click', () => {
                        // Aplicar el filtro en el selector correspondiente
                        if (item.tipo === 'clasificacion') {
                            document.getElementById('filtroCodigoClasificacion').value = item.valor;
                        } else if (item.tipo === 'requisito') {
                            document.getElementById('filtroCodigoRequisito').value = item.valor;
                        }
                        input.value = item.texto;
                        contenedorResultados.classList.add('d-none');
                        cargarGrid();
                    });
                    contenedorResultados.appendChild(btn);
                });

                if (sugerenciasMap.size > 50) {
                    const aviso = document.createElement('div');
                    aviso.className = 'list-group-item text-muted small';
                    aviso.textContent = `Se muestran 50 de ${sugerenciasMap.size} coincidencias. Escriba más para acotar la búsqueda.`;
                    contenedorResultados.appendChild(aviso);
                }
            }

            contenedorResultados.classList.remove('d-none');
        }

        function limpiarFiltroBusqueda() {
            document.getElementById('txtFiltroBusqueda').value = '';
            document.getElementById('resultadosFiltroFlotante').classList.add('d-none');
            document.getElementById('txtFiltroBusqueda').focus();
        }

        document.addEventListener('click', (e) => {
            const contenedor = document.getElementById('resultadosFiltroFlotante');
            const input = document.getElementById('txtFiltroBusqueda');
            if (contenedor && !contenedor.contains(e.target) && e.target !== input) {
                contenedor.classList.add('d-none');
            }
        });

        function limpiarFiltros() {
            document.getElementById('filtroCodigoClasificacion').value = '';
            document.getElementById('filtroCodigoRequisito').value = '';
            document.getElementById('txtFiltroBusqueda').value = '';
            document.getElementById('resultadosFiltroFlotante').classList.add('d-none');
            cargarGrid();
        }

        function abrirModalCrear() {
            document.getElementById('hdnId').value = '0';
            document.getElementById('modalCodigoClasificacion').value = '';
            document.getElementById('modalCodigoRequisito').value = '';
            document.getElementById('modalTitle').innerText = 'Asignar Requisito a Contrato';
            modalBs.show();
        }

        function abrirModalEditar(id, codigoClasificacion, codigoRequisito) {
            document.getElementById('hdnId').value = id;
            document.getElementById('modalCodigoClasificacion').value = codigoClasificacion;
            document.getElementById('modalCodigoRequisito').value = codigoRequisito;
            document.getElementById('modalTitle').innerText = 'Editar Relación';
            modalBs.show();
        }

        function guardarRelacion() {
            const id = parseInt(document.getElementById('hdnId').value);
            const codigoClasificacion = parseInt(document.getElementById('modalCodigoClasificacion').value);
            const codigoRequisito = parseInt(document.getElementById('modalCodigoRequisito').value);

            if (!codigoClasificacion || !codigoRequisito) {
                alert('Debe completar todos los campos requeridos.');
                return;
            }

            const url = id === 0 ? '/RelacionContratoRequisito/Guardar' : '/RelacionContratoRequisito/Actualizar';
            const dto = id === 0 ? { codigoClasificacion, codigoRequisito } : { id, codigoClasificacion, codigoRequisito };

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    modalBs.hide();
                    cargarGrid();
                } else {
                    alert(data.message);
                }
            });
        }

        async function eliminarRelacion(id) {
            if (!await confirmarAccion('¿Está seguro de eliminar esta relación?', { kind: 'danger', confirmText: 'Sí, eliminar' })) return;

            fetch('/RelacionContratoRequisito/Eliminar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(id)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    cargarGrid();
                } else {
                    alert(data.message);
                }
            });
        }
    </script>
}